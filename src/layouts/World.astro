---
import '../styles/world.css';
interface Props {
  title?: string;
  description?: string;
  /** Share card image, a path under public/ */
  image?: string;
}
const {
  title = 'Dean Barquio — Overworld',
  description = 'Dean Barquio, frontend developer and creative engineer from Cebu, PH. Explore a valley of things I have built.',
  image = '/profile.png',
} = Astro.props;
// Scrapers need absolute URLs: set `site` in astro.config.mjs
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1424" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dean Barquio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(image)} />
    {Astro.site && <meta property="og:url" content={abs(Astro.url.pathname)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..500&family=Inter:wght@400..600&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      import { boot } from '../lib/world/ui';
      boot();
    </script>
  </body>
</html>
