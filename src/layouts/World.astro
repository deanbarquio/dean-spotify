---
import '../styles/world.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Dean Barquio — Overworld',
  description = 'Dean Barquio, frontend developer and creative engineer from Cebu, PH. Explore a valley of things I have built.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1424" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..500&family=Inter:wght@400..600&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      import { boot } from '../lib/world/ui';
      boot();
    </script>
  </body>
</html>
