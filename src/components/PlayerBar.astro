---
// PlayerBar.astro — Persistent Spotify-style player bar at bottom
---

<div class="player-bar" id="player-bar">
  <div class="player-bar-inner">

    <div class="player-bar-now">
      <div class="player-bar-art">
        <svg viewBox="0 0 24 24" fill="white" width="22" height="22"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
      </div>
      <div class="player-bar-meta">
        <p>Dean Lourence P. Barquio</p>
        <p>Software Engineer · Cebu City</p>
      </div>
      <svg class="player-bar-like" viewBox="0 0 24 24" fill="var(--sp-green)" width="16" height="16" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/></svg>
    </div>

    <div class="player-bar-center">
      <div class="player-bar-controls">
        <button type="button" class="player-ctrl-btn" aria-label="Shuffle">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M4.5 6.375a4.125 4.125 0 1 1 8.25 0 4.125 4.125 0 0 1-8.25 0ZM14.25 8.625a3.375 3.375 0 1 1 6.75 0 3.375 3.375 0 0 1-6.75 0ZM1.5 19.125a7.125 7.125 0 0 1 14.25 0v.003l-.001.119a.75.75 0 0 1-.363.63 13.067 13.067 0 0 1-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 0 1-.364-.63l-.001-.122ZM17.25 19.128l-.001.144a2.25 2.25 0 0 1-.233.96 10.088 10.088 0 0 0 5.06-1.01.75.75 0 0 0 .42-.643 4.875 4.875 0 0 0-6.957-4.611 8.586 8.586 0 0 1 1.71 5.157v.003Z"/></svg>
        </button>
        <button type="button" class="player-ctrl-btn" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.748 3.373a1 1 0 0 1 .502.868v15.518a1 1 0 0 1-1.5.866L5.252 13.866a1 1 0 0 1 0-1.732L16.75 5.373a1 1 0 0 1 .498-.133V3.373zM6.252 12l10 5.774V6.226L6.252 12zM4 5a1 1 0 0 1 1 1v12a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1z"/></svg>
        </button>
        <button type="button" id="play-btn" class="player-play-btn" aria-label="Play">
          <svg viewBox="0 0 24 24" fill="black" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <button type="button" class="player-ctrl-btn" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M6.252 3.373a1 1 0 0 1 1-.133l11.498 6.493a1 1 0 0 1 0 1.732L7.252 18.373A1 1 0 0 1 5.752 17.51V1.992a1 1 0 0 1 .5-.619zM7.752 6.226v11.548L17.748 12 7.752 6.226zM20 5a1 1 0 0 1 1 1v12a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1z"/></svg>
        </button>
        <button type="button" class="player-ctrl-btn player-ctrl-btn--dim" aria-label="Repeat">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M2 12C2 7.52 5.52 4 10 4h10V2l4 3-4 3V6H10c-3.31 0-6 2.69-6 6s2.69 6 6 6h2v2h-2C5.52 20 2 16.48 2 12zm14 0c0 3.31-2.69 6-6 6v2c4.48 0 8-3.52 8-8h-2z"/></svg>
        </button>
      </div>
      <div class="player-bar-progress">
        <span class="player-time" id="player-prog-time">0:00</span>
        <div class="player-progress-track" id="player-progress-bar">
          <div class="player-progress-fill" id="player-progress-fill">
            <div class="player-progress-knob" id="player-progress-knob"></div>
          </div>
        </div>
        <span class="player-time">3:58</span>
      </div>
    </div>

    <div class="player-bar-extra">
      <a href="https://github.com/deanbarquio" target="_blank" rel="noopener" class="player-link-btn" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://linkedin.com/in/deanbarquio" target="_blank" rel="noopener" class="player-link-btn" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <div class="player-bar-volume">
        <svg viewBox="0 0 24 24" fill="var(--sp-text)" width="16" height="16" aria-hidden="true"><path d="M15 8a5 5 0 0 1 0 8m2.7-10.7a9 9 0 0 1 0 13.4M3 9v6h4l5 5V4L7 9H3z"/></svg>
        <div class="player-volume-track">
          <div class="player-volume-fill"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .player-ctrl-btn,
  .player-link-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--sp-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.15s;
  }

  .player-ctrl-btn:hover,
  .player-link-btn:hover {
    color: #fff;
  }

  .player-ctrl-btn--dim {
    color: var(--sp-text-dim);
  }

  .player-play-btn {
    background: var(--sp-white);
    border: none;
    cursor: pointer;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s;
  }

  .player-play-btn:hover {
    transform: scale(1.06);
  }

  .player-time {
    font-size: 0.65rem;
    color: var(--sp-text);
    width: 30px;
    flex-shrink: 0;
  }

  .player-time:first-child {
    text-align: right;
  }

  .player-progress-track {
    flex: 1;
    height: 4px;
    background: var(--sp-border);
    border-radius: 2px;
    position: relative;
    cursor: pointer;
  }

  .player-progress-fill {
    width: 0%;
    height: 100%;
    background: var(--sp-white);
    border-radius: 2px;
    position: relative;
    transition: background 0.15s;
  }

  .player-progress-knob {
    width: 12px;
    height: 12px;
    background: var(--sp-white);
    border-radius: 50%;
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%) scale(0);
    transition: transform 0.15s;
  }

  .player-progress-track:hover .player-progress-fill {
    background: var(--sp-green);
  }

  .player-progress-track:hover .player-progress-knob {
    transform: translateY(-50%) scale(1);
  }

  .player-volume-track {
    width: 80px;
    height: 4px;
    background: var(--sp-border);
    border-radius: 2px;
    cursor: pointer;
  }

  .player-volume-fill {
    width: 70%;
    height: 100%;
    background: var(--sp-white);
    border-radius: 2px;
    transition: background 0.15s;
  }

  .player-volume-track:hover .player-volume-fill {
    background: var(--sp-green);
  }
</style>

<script>
  import {
    getMainScrollMetrics,
    onMainScroll,
    scrollMainTo,
  } from '../lib/smooth-scroll';

  const bar = document.getElementById('player-progress-bar');
  const fill = document.getElementById('player-progress-fill');
  const knob = document.getElementById('player-progress-knob');
  const timeEl = document.getElementById('player-prog-time');
  const playBtn = document.getElementById('play-btn');

  function getScrollFraction() {
    return getMainScrollMetrics().progress;
  }

  function setScrollFraction(fraction: number) {
    const { maxScroll } = getMainScrollMetrics();
    scrollMainTo(fraction * maxScroll, { duration: 0.85 });
  }

  function updateProgress() {
    const fraction = getScrollFraction();
    const pct = fraction * 100;
    if (fill) fill.style.width = pct + '%';

    const totalSecs = 238;
    const secs = Math.round(fraction * totalSecs);
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    if (timeEl) timeEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;

    if (document.body.classList.contains('album-view-active') && typeof (window as any).updateModalLyrics === 'function') {
      (window as any).updateModalLyrics(fraction);
    }
  }

  function bindScrollProgress() {
    const scroller = document.getElementById('main-scroll');
    if (!scroller || scroller.dataset.playerScrollBound === 'true') return;
    scroller.dataset.playerScrollBound = 'true';
    onMainScroll(updateProgress);
    updateProgress();
  }

  window.addEventListener('resize', updateProgress, { passive: true });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindScrollProgress);
  } else {
    bindScrollProgress();
  }

  (window as any).updateProgress = updateProgress;

  bar?.addEventListener('click', (e) => {
    const rect = bar.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const fraction = Math.max(0, Math.min(1, clickX / rect.width));
    setScrollFraction(fraction);
  });

  let playing = false;
  let scrollInterval: ReturnType<typeof setInterval> | null = null;

  playBtn?.addEventListener('click', () => {
    playing = !playing;
    playBtn.innerHTML = playing
      ? `<svg viewBox="0 0 24 24" fill="black" width="16" height="16"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`
      : `<svg viewBox="0 0 24 24" fill="black" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>`;

    if (playing) {
      scrollInterval = setInterval(() => {
        let currentFraction = getScrollFraction();
        if (currentFraction >= 0.99) {
          playing = false;
          playBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="black" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>`;
          if (scrollInterval) clearInterval(scrollInterval);
          return;
        }
        currentFraction += 0.003;
        setScrollFraction(currentFraction);
      }, 100);
    } else if (scrollInterval) {
      clearInterval(scrollInterval);
    }
  });
</script>
