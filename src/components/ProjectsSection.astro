---

<section id="projects" style="padding:48px 32px 80px;">

  <!-- Header -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;">
    <div>
      <p style="font-size:0.72rem;font-weight:700;color:var(--sp-green);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Discography</p>
      <h2 style="font-size:2rem;font-weight:800;color:#fff;letter-spacing:-0.02em;margin-bottom:4px;">Albums</h2>
      <p style="font-size:0.875rem;color:var(--sp-text);">Every project tells a story</p>
    </div>
    <a href="https://github.com/deanbarquio" target="_blank" rel="noopener"
      style="font-size:0.78rem;font-weight:700;color:var(--sp-text);text-decoration:none;text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid var(--sp-border);padding-bottom:2px;transition:color 0.15s,border-color 0.15s;"
      onmouseover="this.style.color='#fff';this.style.borderColor='#fff'"
      onmouseout="this.style.color='var(--sp-text)';this.style.borderColor='var(--sp-border)'"
    >Show all on GitHub →</a>
  </div>

  <!-- Album grid -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:18px;margin-bottom:64px;" class="album-grid">
    {projects.map((p) => (
      <div
        class="album-card"
        data-id={p.id}
        style="cursor:pointer;position:relative;background:#181818;padding:15px;border-radius:8px;transition:background 0.25s, transform 0.2s;"
        onmouseover="this.style.background='#282828';this.querySelector('.album-play-btn').style.opacity='1';this.querySelector('.album-play-btn').style.transform='translateY(0)';"
        onmouseout="this.style.background='#181818';this.querySelector('.album-play-btn').style.opacity='0';this.querySelector('.album-play-btn').style.transform='translateY(8px)';"
        onclick={`openAlbum('${p.id}')`}
      >
        <!-- Album cover wrapper -->
        <div style="width:100%;aspect-ratio:1/1;border-radius:6px;position:relative;overflow:hidden;margin-bottom:12px;box-shadow:0 8px 20px rgba(0,0,0,0.4);" class="album-art-wrap">
          
          {p.id === 'constrack' && (
            <!-- Constrack Cover -->
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block;">
              <defs>
                <linearGradient id="g-constrack" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3d2800" />
                  <stop offset="100%" stop-color="#120c00" />
                </linearGradient>
                <pattern id="grid-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                  <path d="M 10 0 L 0 0 0 10" fill="none" stroke="#F6A800" stroke-width="0.15" opacity="0.25" />
                </pattern>
              </defs>
              <rect width="100" height="100" fill="url(#g-constrack)" />
              <rect width="100" height="100" fill="url(#grid-pattern)" />
              <!-- Graphic shapes -->
              <circle cx="50" cy="50" r="30" fill="none" stroke="#F6A800" stroke-width="0.8" opacity="0.3" stroke-dasharray="2 1" />
              <circle cx="50" cy="50" r="20" fill="none" stroke="#F6A800" stroke-width="1.5" opacity="0.5" />
              <path d="M20 50 L80 50 M50 20 L50 80" stroke="#F6A800" stroke-width="0.4" opacity="0.2" />
              <!-- Geometric accents -->
              <rect x="35" y="35" width="30" height="30" fill="none" stroke="#F6A800" stroke-width="1.2" opacity="0.8" transform="rotate(45 50 50)" />
              <polygon points="50,42 58,55 42,55" fill="#F6A800" opacity="0.9" />
              <!-- Label -->
              <text x="50" y="86" font-family="'Circular Std', sans-serif" font-weight="900" font-size="7.5" fill="#FFF" text-anchor="middle" letter-spacing="1">CONSTRACK</text>
              <text x="50" y="93" font-family="'Circular Std', sans-serif" font-weight="700" font-size="4" fill="#F6A800" text-anchor="middle" letter-spacing="0.5">TRACK 01</text>
            </svg>
          )}

          {p.id === 'control-panel' && (
            <!-- Control Panel Cover -->
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block;">
              <defs>
                <linearGradient id="g-control" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#001a35" />
                  <stop offset="100%" stop-color="#000914" />
                </linearGradient>
              </defs>
              <rect width="100" height="100" fill="url(#g-control)" />
              <!-- Waveform / Equalizer lines representing Admin features -->
              <g opacity="0.4">
                <line x1="15" y1="50" x2="15" y2="70" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="25" y1="50" x2="25" y2="80" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="35" y1="50" x2="35" y2="60" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="45" y1="50" x2="45" y2="85" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="55" y1="50" x2="55" y2="75" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="65" y1="50" x2="65" y2="65" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="75" y1="50" x2="75" y2="80" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="85" y1="50" x2="85" y2="60" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
              </g>
              <g opacity="0.4" transform="scale(1, -1) translate(0, -100)">
                <line x1="15" y1="50" x2="15" y2="65" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="25" y1="50" x2="25" y2="75" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="35" y1="50" x2="35" y2="80" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="45" y1="50" x2="45" y2="60" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="55" y1="50" x2="55" y2="80" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="65" y1="50" x2="65" y2="70" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="75" y1="50" x2="75" y2="60" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
                <line x1="85" y1="50" x2="85" y2="75" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" />
              </g>
              <!-- Target ring -->
              <circle cx="50" cy="50" r="16" fill="none" stroke="#FFF" stroke-width="1" opacity="0.2" />
              <circle cx="50" cy="50" r="8" fill="#FFF" opacity="0.85" />
              <!-- Title -->
              <text x="50" y="24" font-family="'Circular Std', sans-serif" font-weight="900" font-size="8" fill="#FFF" text-anchor="middle" letter-spacing="1.5">CONTROL PANEL</text>
              <text x="50" y="32" font-family="'Circular Std', sans-serif" font-weight="700" font-size="4" fill="#3B82F6" text-anchor="middle" letter-spacing="0.5">INTERNAL SYSTEM</text>
            </svg>
          )}

          {p.id === 'component-pantry' && (
            <!-- Component Pantry Cover -->
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block;">
              <defs>
                <linearGradient id="g-pantry" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#240c46" />
                  <stop offset="100%" stop-color="#0a0318" />
                </linearGradient>
              </defs>
              <rect width="100" height="100" fill="url(#g-pantry)" />
              <!-- Abstract layered components -->
              <rect x="20" y="25" width="40" height="12" rx="4" fill="#8B5CF6" opacity="0.25" />
              <rect x="40" y="42" width="40" height="12" rx="4" fill="#8B5CF6" opacity="0.4" />
              <rect x="30" y="59" width="45" height="12" rx="4" fill="#8B5CF6" opacity="0.65" />
              <!-- Dots in grid representing npm imports -->
              <circle cx="28" cy="31" r="2.5" fill="#FFF" opacity="0.7" />
              <circle cx="72" cy="48" r="2.5" fill="#FFF" opacity="0.9" />
              <circle cx="38" cy="65" r="2.5" fill="#8B5CF6" />
              <circle cx="68" cy="65" r="2" fill="#FFF" opacity="0.5" />
              <!-- Title -->
              <text x="50" y="84" font-family="'Circular Std', sans-serif" font-weight="900" font-size="7" fill="#FFF" text-anchor="middle" letter-spacing="1">UI PANTRY</text>
              <text x="50" y="90" font-family="'Circular Std', sans-serif" font-weight="700" font-size="3.5" fill="#8B5CF6" text-anchor="middle" letter-spacing="0.5">LIBRARY VOL. 3</text>
            </svg>
          )}

          {p.id === 'ntv-dashboard' && (
            <!-- NTV Dashboard Cover -->
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block;">
              <defs>
                <linearGradient id="g-ntv" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#002d1a" />
                  <stop offset="100%" stop-color="#000e08" />
                </linearGradient>
              </defs>
              <rect width="100" height="100" fill="url(#g-ntv)" />
              <!-- Styled graphic: stats grid -->
              <rect x="15" y="20" width="32" height="24" rx="3" fill="none" stroke="#10B981" stroke-width="1" opacity="0.5" />
              <path d="M22 36 L28 30 L34 33 L40 26" fill="none" stroke="#10B981" stroke-width="1.5" />
              <circle cx="40" cy="26" r="1.5" fill="#10B981" />
              
              <rect x="53" y="20" width="32" height="24" rx="3" fill="none" stroke="#10B981" stroke-width="1" opacity="0.5" />
              <rect x="59" y="32" width="20" height="4" rx="2" fill="#10B981" opacity="0.7" />
              <circle cx="63" cy="27" r="2" fill="#10B981" />
              
              <!-- Bottom track visualizer -->
              <rect x="15" y="54" width="70" height="12" rx="3" fill="none" stroke="#10B981" stroke-width="1.2" />
              <line x1="22" y1="60" x2="60" y2="60" stroke="#10B981" stroke-width="3" opacity="0.75" />
              <line x1="60" y1="60" x2="78" y2="60" stroke="#FFF" stroke-width="3" opacity="0.2" />
              <!-- Title -->
              <text x="50" y="82" font-family="'Circular Std', sans-serif" font-weight="900" font-size="7" fill="#FFF" text-anchor="middle" letter-spacing="1.2">NTV DASHBOARD</text>
              <text x="50" y="89" font-family="'Circular Std', sans-serif" font-weight="700" font-size="3.5" fill="#10B981" text-anchor="middle" letter-spacing="0.5">HR TRACKING</text>
            </svg>
          )}

          {p.id === 'psits' && (
            <!-- PSITS Website Cover -->
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block;">
              <defs>
                <linearGradient id="g-psits" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3c0f0f" />
                  <stop offset="100%" stop-color="#160505" />
                </linearGradient>
              </defs>
              <rect width="100" height="100" fill="url(#g-psits)" />
              <path d="M20 30 L80 30 M20 50 L80 50 M20 70 L80 70" stroke="#EF4444" stroke-width="1.5" opacity="0.3" />
              <circle cx="50" cy="50" r="24" fill="none" stroke="#EF4444" stroke-width="1.2" opacity="0.6" />
              <polygon points="50,38 58,48 42,48" fill="#FFF" opacity="0.8" />
              <text x="50" y="82" font-family="'Circular Std', sans-serif" font-weight="900" font-size="7.5" fill="#FFF" text-anchor="middle" letter-spacing="1.2">PSITS PORTAL</text>
              <text x="50" y="89" font-family="'Circular Std', sans-serif" font-weight="700" font-size="3.5" fill="#EF4444" text-anchor="middle" letter-spacing="0.5">ORGANIZATION</text>
            </svg>
