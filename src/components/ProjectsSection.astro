  {
    id: 'psits',
    title: 'PSITS Website',
    artist: 'Dean Barquio · Organization Portal',
    type: 'Web Portal',
    year: '2024',
    duration: '4 months',
    accent: '#EF4444',
    image: '/psits_website.png',
    gradient: 'linear-gradient(135deg,#3c0f0f,#160505)',
    description: 'Automating student organization membership workflow and merchandise sales portal.',
    longDesc: 'Designed to handle students admissions, automated receipt validation, dynamic membership cards generation, and event registration with built-in financial reporting.',
    tags: ['React', 'Node.js', 'MongoDB', 'TailwindCSS'],
    tracks: [
      { name: 'Membership Portal', duration: '1:45' },
      { name: 'Merchandising Shop', duration: '2:12' },
      { name: 'Payment Validation Flow', duration: '1:30' },
      { name: 'Member Statistics', duration: '1:15' },
    ],
    lyrics: [
      "Accessing PSITS Organization Portal...",
      "Automating student membership applications,",
      "Processing merchandise payments and event tickets,",
      "Empowering the IT student community board,",
      "Finance volunteer tracker and accounting reports,",
      "Streamlining organizational workflows online,",
