    year: '2024',
    duration: '3 months',
    accent: '#F97316',
    image: '/hikemate_1.jpeg',
    gradient: 'linear-gradient(135deg,#2d1000,#190800)',
    description: 'Mobile hiking companion showing topographic trails, elevation details, and offline maps.',
    longDesc: 'Built in Flutter with MapLibre integrations and custom geolocated pace metrics. Supports route recording and trail search.',
    tags: ['Flutter', 'Kotlin', 'OpenStreetMap', 'MapLibre', 'GPS'],
    tracks: [
      { name: 'Trail Map View', duration: '1:33' },
