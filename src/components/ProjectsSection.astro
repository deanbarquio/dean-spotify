---
// ProjectsSection.astro — True Spotify Album grid with detail modal
const projects = [
  {
    id: 'constrack',
    title: 'Constrack',
    artist: 'Dean Barquio · Full-Stack',
    type: 'Full-Stack App',
    year: '2025',
    duration: '6 months',
    accent: '#F6A800',
