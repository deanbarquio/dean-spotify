      { name: 'Design Token System', duration: '0:55' },
      { name: 'npm Package Pipeline', duration: '1:20' },
    ],
    lyrics: [
      "Importing NTV360 Component Pantry...",
      "Publishing to internal Verdaccio registry,",
      "Reusable Angular elements accelerating UI build,",
      "Form controls, data tables, and ApexCharts integrated,",
      "Standardizing design systems for every team,",
      "Reducing development time by forty percent,",
      "Reusable component packages loaded successfully."
    ]
  },
  {
    id: 'ntv-dashboard',
    title: 'NTV Dashboard',
    artist: 'Dean Barquio · HR System',
    type: 'HR Tracking',
