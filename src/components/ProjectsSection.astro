    },
    {
      id: 'hikemate', title: 'Hikemate', artist: 'Dean Barquio · Mobile App', type: 'Mobile App', year: '2024', duration: '3 months',
      accent: '#F97316', image: '/hikemate_1.jpeg', gradient: 'linear-gradient(135deg,#2d1000,#190800)',
      description: 'Mobile hiking companion showing topographic trails, elevation details, and offline maps.',
      longDesc: 'Built in Flutter with MapLibre integrations and custom geolocated pace metrics. Supports route recording and trail search.',
      tags: ['Flutter', 'Kotlin', 'OpenStreetMap', 'MapLibre', 'GPS'],
      tracks: [
        { name: 'Trail Map View', duration: '1:33' },
        { name: 'Live GPS Tracker', duration: '2:44' },
        { name: 'Elevation Profiler', duration: '1:15' },
        { name: 'Pace Calculator', duration: '0:52' },
        { name: 'Route Recorder', duration: '1:08' },
      ],
      lyrics: [
        "Starting Hikemate tracking session...",
        "Loading offline trail maps via MapLibre,",
        "Calculating elevation profiles and pace dynamically,",
        "GPS tracker logging path and route points,",
        "Flutter mobile client running natively,",
        "Hiking route successfully recorded to database,",
        "Tracking active: trail navigation complete."
      ]
    },
  ];

  function openAlbum(id: string) {
    const p = projects.find(x => x.id === id);
    if (!p) return;

    const detailView = document.getElementById('album-detail-view')!;
    const header = document.getElementById('modal-header')!;
    const art = document.getElementById('modal-art')!;
    const glow = document.getElementById('modal-glow')!;
    const lyricsCard = document.getElementById('modal-lyrics-card')!;
    const discCenter = document.getElementById('disc-art-center')!;
    const rotator = document.getElementById('disc-rotator')!;

    stopLyricTimer();
    albumPlaying = false;
    window.albumPlaying = false;
    rotator.classList.remove('playing');

    // Set gradient
    header.style.background = p.gradient;
    glow.style.background = `radial-gradient(ellipse at 0% 0%, ${p.accent}20, transparent 60%)`;

    lyricsCard.style.background = p.accent;
    lyricsCard.style.boxShadow = `0 16px 40px ${p.accent}26`;

    // Set disc center image from project image field
    if (p.image) {
      discCenter.innerHTML = `<img src="${p.image}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
    } else {
      discCenter.innerHTML = '<div style="width:100%;height:100%;background:rgba(0,0,0,0.4);border-radius:50%;"></div>';
    }

    // Set content
    document.getElementById('modal-title')!.textContent = p.title;
    document.getElementById('modal-artist')!.textContent = p.artist;
    document.getElementById('modal-meta')!.textContent = `${p.type} · ${p.year} · ${p.duration}`;
    document.getElementById('modal-desc')!.textContent = p.description;
    document.getElementById('modal-long-desc')!.textContent = p.longDesc;

    // Set types (Single or Album) based on project specs
    const typeLabel = document.getElementById('modal-type-label')!;
    typeLabel.textContent = p.type.includes('Library') || p.type.includes('System') || p.type.includes('App') ? 'Album' : 'Single';

    // Set release metadata
    const dateStr = p.year === '2025' ? 'January 15, 2025' : 'August 24, 2024';
    document.getElementById('modal-release-date')!.textContent = `Released: ${dateStr}`;
    document.getElementById('modal-copyright-1')!.textContent = `© ${p.year} Dean Barquio, under NTV360 & PSITS label.`;
    document.getElementById('modal-copyright-2')!.textContent = `℗ ${p.year} Dean Barquio under company portfolio release.`;

    // Follow button text reset
    const followBtn = document.getElementById('modal-follow-btn')!;
    followBtn.textContent = 'Follow';

    // Tags
    const tagsEl = document.getElementById('modal-tags')!;
    tagsEl.innerHTML = p.tags.map(t =>
      `<span style="font-size:0.72rem;padding:4px 10px;border-radius:6px;background:${p.accent}15;color:${p.accent};font-weight:600;border:1px solid ${p.accent}25;margin:2px;">${t}</span>`
    ).join('');

    // Tracks
    const tracksEl = document.getElementById('modal-tracks')!;
    const basePlays = p.title.length * 1238495;
    tracksEl.innerHTML = p.tracks.map((t, i) => {
      const trackPlays = Math.round(basePlays / (i + 1)).toLocaleString();
      return `
        <div style="display:grid;grid-template-columns:40px 1.5fr 1fr 60px;gap:16px;padding:12px 8px;border-radius:6px;align-items:center;cursor:pointer;transition:background 0.15s;"
          class="track-row"
          onmouseover="this.style.background='rgba(255,255,255,0.06)';this.querySelector('.tn').style.display='none';this.querySelector('.tp').style.display='flex'"
          onmouseout="this.style.background='transparent';this.querySelector('.tn').style.display='block';this.querySelector('.tp').style.display='none'">
          <div style="position:relative;display:flex;align-items:center;">
            <span class="tn" style="font-size:0.85rem;color:${i===0?p.accent:'var(--sp-text-dim)'};font-weight:600;">${String(i+1).padStart(2,'0')}</span>
            <span class="tp" style="display:none;align-items:center;"><svg viewBox="0 0 24 24" fill="white" width="14" height="14"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <div>
            <p style="font-size:0.88rem;font-weight:600;color:${i===0?p.accent:'#fff'};margin-bottom:2px;">${t.name}</p>
            <p style="font-size:0.75rem;color:var(--sp-text-dim);">${p.artist.split('·')[0].trim()}</p>
          </div>
          <span style="font-size:0.82rem;color:var(--sp-text-dim);">${trackPlays}</span>
          <span style="font-size:0.82rem;color:var(--sp-text-dim);justify-self:end;">${t.duration}</span>
        </div>
      `;
    }).join('');

    const lyricsLabel = document.getElementById('modal-lyrics-label');
    if (lyricsLabel) lyricsLabel.textContent = `${p.title} Lyrics`;

    const lyricsRoot = document.getElementById('modal-lyrics-card')!;
    const lyricsEl = document.getElementById('modal-lyrics-container')!;
    lyricsEl.innerHTML = renderLyricLines(p.lyrics);
    lyricsEl.scrollTop = 0;
    initLyricsPanel(lyricsRoot, (idx) => {
      currentLyricIdx = idx;
      syncAlbumProgressFromLyricIndex(idx);
    });

    const creditsEl = document.getElementById('modal-credits-container')!;
    const stackLine = p.tags.join(', ');
    creditsEl.innerHTML = [
      { label: 'Performers', name: 'Dean Lourence P. Barquio', role: p.artist },
      { label: 'Writers / Stack', name: p.title, role: stackLine },
      { label: 'Producers / Type', name: `${p.type} · ${p.year}`, role: p.duration },
      { label: 'Publishers / Release', name: 'Dean Barquio Portfolio', role: p.description },
    ]
      .map(
        (item) => `
        <div style="border-bottom:1px solid rgba(255,255,255,0.05);padding-bottom:14px;">
          <p style="font-size:0.68rem;font-weight:700;color:var(--sp-text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">${item.label}</p>
          <p style="font-size:0.86rem;font-weight:700;color:#fff;margin-bottom:2px;">${item.name}</p>
          <p style="font-size:0.72rem;color:var(--sp-text);line-height:1.4;">${item.role}</p>
        </div>`
      )
      .join('');

    currentLyricIdx = 0;

    // Calculate total duration from track times
    const totalSecs = p.tracks.reduce((sum: number, t: { duration: string }) => {
      const [m, s] = t.duration.split(':').map(Number);
      return sum + m * 60 + s;
    }, 0);
    window.albumTotalSecs = totalSecs;
    const fill = document.getElementById('album-progress-fill');
    const elapsed = document.getElementById('progress-elapsed');
    const total = document.getElementById('progress-total');
    if (fill) fill.style.width = '0%';
    if (elapsed) elapsed.textContent = '0:00';
    if (total) total.textContent = `${Math.floor(totalSecs / 60)}:${String(totalSecs % 60).padStart(2, '0')}`;

    // Show detailed view & trigger routing class
    document.body.classList.add('album-view-active');
    detailView.style.display = 'block';

    // scroll the main page to the top of the new page
    const scroller = document.getElementById('main-scroll')!;
    scroller.scrollTop = 0;

    // dispatch global event to update player progress
    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }
  }

  function closeAlbum(options: { scrollToProjects?: boolean } = {}) {
    const { scrollToProjects = true } = options;
    stopLyricTimer();
    albumPlaying = false;
    const detailView = document.getElementById('album-detail-view')!;
    document.body.classList.remove('album-view-active');
    detailView.style.display = 'none';

    if (scrollToProjects) {
      const scroller = document.getElementById('main-scroll');
      const projects = document.getElementById('projects');
      if (scroller && projects) {
        const top =
          projects.getBoundingClientRect().top -
          scroller.getBoundingClientRect().top +
          scroller.scrollTop -
          56;
        scroller.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      }
    }

    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }
  }

  let albumPlaying = false;
  let currentLyricIdx = 0;
  let lyricTimer: ReturnType<typeof setInterval> | null = null;

  function getAlbumLyricsRoot() {
    return document.getElementById('modal-lyrics-card');
  }

  function getAlbumLyricsElements() {
    const root = getAlbumLyricsRoot();
    const container = root?.querySelector('.lyrics-container') as HTMLElement | null;
    const lines = container?.querySelectorAll('.lyric-line') as NodeListOf<HTMLElement> | undefined;
    return { root, container, lines };
  }

  function syncAlbumProgressFromLyricIndex(idx: number) {
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;

    const fill = document.getElementById('album-progress-fill');
    const elapsed = document.getElementById('progress-elapsed');
    const total = document.getElementById('progress-total');
    if (!fill || !elapsed || !total) return;

    const pct = lines.length > 1 ? idx / (lines.length - 1) : 0;
    fill.style.width = `${pct * 100}%`;
    const totalSecs = (window as any).albumTotalSecs || lines.length * 4;
    const elapsedSecs = Math.floor(pct * totalSecs);
    elapsed.textContent = `${Math.floor(elapsedSecs / 60)}:${String(elapsedSecs % 60).padStart(2, '0')}`;
    total.textContent = `${Math.floor(totalSecs / 60)}:${String(totalSecs % 60).padStart(2, '0')}`;
  }

  function setAlbumLyricIndex(idx: number) {
    const { container, lines } = getAlbumLyricsElements();
    if (!container || !lines?.length) return;
    currentLyricIdx = idx;
    activateLyricLine(container, lines, lines[idx] as HTMLElement);
    syncAlbumProgressFromLyricIndex(idx);
  }

  function stopLyricTimer() {
    if (lyricTimer) {
      clearInterval(lyricTimer);
      lyricTimer = null;
    }
  }

  function startLyricTimer() {
    stopLyricTimer();
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;

    lyricTimer = setInterval(() => {
      currentLyricIdx++;
      if (currentLyricIdx >= lines.length) currentLyricIdx = 0;
      setAlbumLyricIndex(currentLyricIdx);
    }, 4000);
  }

  (window as any).updateModalLyrics = function (fraction: number) {
    const root = getAlbumLyricsRoot();
    if (!root) return;
    const idx = syncLyricsFromFraction(root, fraction);
    currentLyricIdx = idx;
    syncAlbumProgressFromLyricIndex(idx);
  };

  (window as any).seekToLyric = function (index: number) {
    setAlbumLyricIndex(index);
    if (albumPlaying) startLyricTimer();
  };

  function togglePlay() {
    const rotator = document.getElementById('disc-rotator');
    const btn = document.getElementById('modal-play-btn');
    const { lines } = getAlbumLyricsElements();
    if (!rotator || !lines?.length) return;

    albumPlaying = !albumPlaying;

    if (albumPlaying) {
      rotator.classList.add('playing');
      if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" fill="black" width="24" height="24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      if (currentLyricIdx >= lines.length) currentLyricIdx = 0;
      setAlbumLyricIndex(currentLyricIdx);
      startLyricTimer();
    } else {
      rotator.classList.remove('playing');
      if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" fill="black" width="24" height="24"><path d="M8 5v14l11-7z"/></svg>';
      stopLyricTimer();
    }
  }

  // ── Play button toggle ──
  document.getElementById('modal-play-btn')?.addEventListener('click', togglePlay);
  document.getElementById('modal-art')?.addEventListener('click', togglePlay);

  // ── Progress bar seek ──
  const progressTrack = document.getElementById('progress-track');
  progressTrack?.addEventListener('click', function(e) {
    const rect = this.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;
    const idx = lyricIndexFromFraction(lines.length, pct);
    (window as any).seekToLyric(idx);
  });

  // Close album overlay when navigating elsewhere (do not hijack scroll target)
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.sb-nav-link, .sb-lib-item, #sb-home-link').forEach((link) => {
      link.addEventListener('click', () => {
        if (!document.body.classList.contains('album-view-active')) return;
        closeAlbum({ scrollToProjects: false });
      });
    });
  });

  // Make functions global
  (window as any).openAlbum = openAlbum;
  (window as any).closeAlbum = closeAlbum;

  // ESC to close
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      stopLyricTimer();
      albumPlaying = false;
      closeAlbum();
    }
  });

  document.getElementById('album-share-lyrics-btn')?.addEventListener('click', async () => {
    const { container } = getAlbumLyricsElements();
    if (!container) return;
    const text = Array.from(container.querySelectorAll('.lyric-line'))
      .map((l) => l.textContent)
      .join('\n');
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      /* clipboard unavailable */
    }
  });
</script>
