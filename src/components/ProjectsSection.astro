function featuredLine(tags: string[]) {
  if (!tags.length) return '';
  if (tags.length <= 3) return tags.join(', ');
  return `${tags.slice(0, 3).join(', ')} and more`;
}

const albumRowPrimary = projects.slice(0, 4);
const albumRowSecondary = projects.slice(4, 8);
---

<section id="projects" style="padding:48px 32px 80px;">

  <!-- Header -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;">
    <div>
      <p style="font-size:0.72rem;font-weight:700;color:var(--sp-green);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Discography</p>
      <h2 style="font-size:2rem;font-weight:800;color:#fff;letter-spacing:-0.02em;margin-bottom:4px;">Albums</h2>
      <p style="font-size:0.875rem;color:var(--sp-text);">Every project tells a story</p>
    </div>
    <a href="https://github.com/deanbarquio" target="_blank" rel="noopener"
      style="font-size:0.78rem;font-weight:700;color:var(--sp-text);text-decoration:none;text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid var(--sp-border);padding-bottom:2px;transition:color 0.15s,border-color 0.15s;"
      onmouseover="this.style.color='#fff';this.style.borderColor='#fff'"
      onmouseout="this.style.color='var(--sp-text)';this.style.borderColor='var(--sp-border)'"
    >Show all on GitHub →</a>
  </div>

  <!-- Album rows — Spotify "Made for you" mix cards -->
  <div class="album-showcase">
    <section class="album-row" aria-label="Made for you mixes">
      <div class="album-row-header">
        <h3 class="album-row-title">Made for you</h3>
        <a href="https://github.com/deanbarquio" target="_blank" rel="noopener" class="album-row-link">Show all</a>
      </div>
      <div class="mix-row-grid">
        {albumRowPrimary.map((p) => (
          <button
            type="button"
            class="mix-card js-album-mix"
            data-id={p.id}
            style={`--mix-accent:${p.accent};`}
            onclick={`openAlbum('${p.id}')`}
          >
            <div class="mix-card-cover">
              {p.image ? (
                <img src={p.image} alt="" loading="lazy" decoding="async" />
              ) : (
                <div class="mix-card-cover-fallback" style={`background:${p.gradient};`}>
                  <span>{p.title[0]}</span>
                </div>
              )}
              <div class="mix-card-vignette" aria-hidden="true"></div>
              <span class="mix-card-pill">Mix</span>
              <span class="mix-card-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="mix-card-body">
              <p class="mix-card-title">{p.title}</p>
              <p class="mix-card-sub">Playlist · {p.type}</p>
              <p class="mix-card-tags">{featuredLine(p.tags)}</p>
            </div>
          </button>
        ))}
      </div>
    </section>

    <section class="album-row" aria-label="More projects">
      <div class="album-row-header">
        <h3 class="album-row-title">More like your stack</h3>
        <a href="#projects" class="album-row-link">Show all</a>
      </div>
      <div class="mix-row-grid">
        {albumRowSecondary.map((p) => (
          <button
            type="button"
            class="mix-card js-album-mix"
            data-id={p.id}
            style={`--mix-accent:${p.accent};`}
            onclick={`openAlbum('${p.id}')`}
          >
            <div class="mix-card-cover">
              {p.image ? (
                <img src={p.image} alt="" loading="lazy" decoding="async" />
              ) : (
                <div class="mix-card-cover-fallback" style={`background:${p.gradient};`}>
                  <span>{p.title[0]}</span>
                </div>
              )}
              <div class="mix-card-vignette" aria-hidden="true"></div>
              <span class="mix-card-pill">Mix</span>
              <span class="mix-card-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="mix-card-body">
              <p class="mix-card-title">{p.title}</p>
              <p class="mix-card-sub">Playlist · {p.type}</p>
              <p class="mix-card-tags">{featuredLine(p.tags)}</p>
            </div>
          </button>
        ))}
      </div>
    </section>
  </div>

  <!-- Album Detail Page View (Full Page Replacement) -->
  <div id="album-detail-view" data-native-scroll style="display:none;position:relative;width:calc(100% + 64px);margin-top:-48px;margin-left:-32px;margin-right:-32px;min-height:100vh;background:var(--sp-bg);z-index:5;">
    
    <!-- Header with custom gradient -->
    <div id="modal-header" style="padding:80px 40px 40px;position:relative;overflow:hidden;background:#282828;display:flex;flex-direction:column;justify-content:flex-end;">
      <div id="modal-glow" style="position:absolute;inset:0;pointer-events:none;"></div>
      
      <!-- Back button matching Spotify navigation bar arrow -->
      <button onclick="closeAlbum()" style="position:absolute;top:24px;left:40px;background:rgba(0,0,0,0.6);border:none;cursor:pointer;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;z-index:10;transition:background 0.2s, transform 0.1s;"
        onmouseover="this.style.background='rgba(0,0,0,0.8)';this.style.transform='scale(1.05)';"
        onmouseout="this.style.background='rgba(0,0,0,0.6)';this.style.transform='scale(1)';"
        title="Back to discography">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>

      <div style="display:flex;align-items:flex-end;gap:32px;position:relative;z-index:1;" class="modal-header-content">
        <!-- Disc player -->
        <div id="modal-art" style="width:232px;height:232px;border-radius:50%;flex-shrink:0;position:relative;box-shadow:0 24px 50px rgba(0,0,0,0.6);overflow:hidden;" title="Click to play / pause">
          <div id="disc-rotator" class="disc-rotator">
            <div class="disc-vinyl">
              <div class="disc-groove"></div>
              <div class="disc-groove"></div>
              <div class="disc-groove"></div>
              <div class="disc-groove"></div>
              <div class="disc-groove"></div>
              <div class="disc-art-center" id="disc-art-center"></div>
              <div class="disc-spindle"></div>
              <div class="disc-shine"></div>
            </div>
          </div>
        </div>

        <div>
          <p id="modal-type-label" style="font-size:0.75rem;font-weight:700;color:rgba(255,255,255,0.9);text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;">Album</p>
          <h2 id="modal-title" style="font-size:clamp(2.5rem, 5vw, 4.8rem);font-weight:900;color:#fff;letter-spacing:-0.03em;margin:8px 0;line-height:1.05;"></h2>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:0.88rem;">
            <span id="modal-artist" style="color:#fff;font-weight:700;"></span>
            <span style="color:rgba(255,255,255,0.6);">•</span>
            <span id="modal-meta" style="color:rgba(255,255,255,0.8);font-weight:600;"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions Toolbar -->
    <div style="padding:24px 40px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.05);background:linear-gradient(to bottom, rgba(0,0,0,0.2), transparent);">
      <div style="display:flex;align-items:center;gap:24px;">
        <!-- Large Play button -->
        <button id="modal-play-btn" style="width:56px;height:56px;border-radius:50%;background:var(--sp-green);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform 0.2s,background 0.15s;box-shadow:0 8px 16px rgba(0,0,0,0.3);"
          onmouseover="this.style.background='#1ed760';this.style.transform='scale(1.06)'"
          onmouseout="this.style.background='var(--sp-green)';this.style.transform='scale(1)'">
          <svg viewBox="0 0 24 24" fill="black" width="24" height="24"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <!-- Heart / plus add button -->
        <button style="background:none;border:none;color:var(--sp-text);cursor:pointer;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--sp-text)'">
          <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
        </button>
        <!-- Follow button -->
        <button style="background:none;border:1px solid rgba(255,255,255,0.3);border-radius:500px;padding:8px 24px;color:#fff;font-size:0.85rem;font-weight:700;cursor:pointer;transition:border-color 0.2s,transform 0.1s;"
          onmouseover="this.style.borderColor='#fff';this.style.transform='scale(1.02)';" 
          onmouseout="this.style.borderColor='rgba(255,255,255,0.3)';this.style.transform='scale(1)';"
          id="modal-follow-btn">Follow</button>
        <!-- Three-dots button -->
        <button style="background:none;border:none;color:var(--sp-text);cursor:pointer;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--sp-text)'">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
        </button>
      </div>
      <div>
        <div style="display:flex;align-items:center;gap:10px;">
          <!-- Queue / projects drawer toggle -->
          <button
            id="album-queue-toggle"
            type="button"
            class="album-queue-toggle"
            aria-haspopup="dialog"
            aria-controls="album-queue-drawer"
            aria-expanded="false"
            title="Open project queue"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M3 10h13v2H3v-2zm0-4h13v2H3V6zm0 8h13v2H3v-2zm15.5-3.5v-3L22 11l-3.5 3.5v-3z"/>
            </svg>
            <span>Queue</span>
          </button>
          <!-- Lyrics voice toggle (Web Speech API) -->
          <button
            id="album-voice-toggle"
            type="button"
            class="album-queue-toggle"
            aria-pressed="false"
            title="Toggle lyric singing"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2z"/>
            </svg>
            <span>Sing</span>
          </button>
          <!-- List toggle icon representing Spotify list display -->
          <div style="display:flex;align-items:center;gap:8px;color:var(--sp-text);font-size:0.8rem;font-weight:600;">
            <span>List</span>
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M4 15h16v-2H4v2zm0 4h16v-2H4v2zm0-8h16V9H4v2zm0-6v2h16V5H4z"/></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Bar -->
    <div style="padding:8px 40px 0;display:flex;align-items:center;gap:12px;">
      <div class="progress-wrap">
        <span class="progress-time" id="progress-elapsed">0:00</span>
        <div class="progress-track" id="progress-track">
          <div class="progress-fill" id="album-progress-fill">
            <div class="progress-thumb"></div>
          </div>
        </div>
        <span class="progress-time" id="progress-total">0:00</span>
      </div>
    </div>

    <!-- Tracks and Info Block -->
    <div style="padding:32px 40px 24px;display:flex;flex-direction:column;gap:32px;">
      <!-- Tracklist Table -->
      <div>
        <!-- Table columns header row -->
        <div style="display:grid;grid-template-columns:40px 1.5fr 1fr 60px;gap:16px;padding:8px;border-bottom:1px solid rgba(255,255,255,0.08);color:var(--sp-text-dim);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:16px;align-items:center;">
          <span>#</span>
          <span>Title</span>
          <span>Plays</span>
          <span style="justify-self:end;"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm3.3 14.88L11 12.42V7h1.5v4.74l3.52 2.1-.73 1.04z"/></svg></span>
        </div>
        <!-- Dynamic tracks container -->
        <div id="modal-tracks" style="display:flex;flex-direction:column;gap:2px;"></div>
      </div>

      <!-- Description Info block -->
      <div style="display:grid;grid-template-columns:1.25fr 0.75fr;gap:24px;align-items:start;" class="edu-layout">
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);border-radius:12px;padding:24px;">
