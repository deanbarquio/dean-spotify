    lyricsEl.innerHTML = renderLyricLines(p.lyrics);
    lyricsEl.scrollTop = 0;
    initLyricsPanel(lyricsRoot, (idx) => {
      currentLyricIdx = idx;
      syncAlbumProgressFromLyricIndex(idx);
    });

    const creditsEl = document.getElementById('modal-credits-container')!;
    const stackLine = p.tags.join(', ');
    creditsEl.innerHTML = [
      { label: 'Performers', name: 'Dean Lourence P. Barquio', role: p.artist },
      { label: 'Writers / Stack', name: p.title, role: stackLine },
      { label: 'Producers / Type', name: `${p.type} · ${p.year}`, role: p.duration },
      { label: 'Publishers / Release', name: 'Dean Barquio Portfolio', role: p.description },
    ]
      .map(
        (item) => `
        <div style="border-bottom:1px solid rgba(255,255,255,0.05);padding-bottom:14px;">
          <p style="font-size:0.68rem;font-weight:700;color:var(--sp-text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">${item.label}</p>
          <p style="font-size:0.86rem;font-weight:700;color:#fff;margin-bottom:2px;">${item.name}</p>
          <p style="font-size:0.72rem;color:var(--sp-text);line-height:1.4;">${item.role}</p>
        </div>`
      )
      .join('');

    currentLyricIdx = 0;

    // Calculate total duration from track times
    const totalSecs = p.tracks.reduce((sum: number, t: { duration: string }) => {
      const [m, s] = t.duration.split(':').map(Number);
      return sum + m * 60 + s;
    }, 0);
    window.albumTotalSecs = totalSecs;
    const fill = document.getElementById('album-progress-fill');
    const elapsed = document.getElementById('progress-elapsed');
    const total = document.getElementById('progress-total');
    if (fill) fill.style.width = '0%';
    if (elapsed) elapsed.textContent = '0:00';
    if (total) total.textContent = `${Math.floor(totalSecs / 60)}:${String(totalSecs % 60).padStart(2, '0')}`;

    // Show detailed view & trigger routing class
    document.body.classList.add('album-view-active');
    detailView.style.display = 'block';
    detailView.scrollTop = 0;
    lastSpokenLine = '';
    // Ensure play is gated by voice readiness whenever album view opens
    initVoiceReadiness();

    // Lock the main scroller; the album view becomes the scroll container
    document.getElementById('main-scroll')?.classList.add('main-scroll--locked');

    scrollMainTo(0, { immediate: true });

    // dispatch global event to update player progress
    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }

    // Keep queue in sync with current album
    updateQueueUI();

    // Open queue by default when viewing an album
    openQueue();
  }

  function closeAlbum(options: { scrollToProjects?: boolean } = {}) {
    const { scrollToProjects = true } = options;
    stopLyricTimer();
    albumPlaying = false;
    const detailView = document.getElementById('album-detail-view')!;
    document.body.classList.remove('album-view-active');
    detailView.style.display = 'none';
    document.getElementById('main-scroll')?.classList.remove('main-scroll--locked');
    stopLyricVoice();

    if (scrollToProjects) {
      const scroller = document.getElementById('main-scroll');
      const projects = document.getElementById('projects');
      if (scroller && projects) {
        const { scrollTop } = getMainScrollMetrics();
        const top =
          projects.getBoundingClientRect().top -
          scroller.getBoundingClientRect().top +
          scrollTop -
          56;
        scrollMainTo(Math.max(0, top), { duration: 1.1 });
      }
    }

    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }

    closeQueue();
  }

  let albumPlaying = false;
  let currentLyricIdx = 0;
  let lyricTimer: ReturnType<typeof setInterval> | null = null;
  let currentAlbumId: string | null = null;
  let lyricVoiceEnabled = false;
  let lastSpokenLine = '';
  let lyricVoiceReady = false;

  const VOICE_KEY = 'dean.albumLyricsVoice.v1';

  function canSpeakLyrics() {
    return typeof window !== 'undefined' && 'speechSynthesis' in window && typeof SpeechSynthesisUtterance !== 'undefined';
  }

  function setVoiceToggleUI(state: { ready: boolean; enabled: boolean }) {
    const btn = document.getElementById('album-voice-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    btn.disabled = !state.ready;
    btn.setAttribute('aria-pressed', state.enabled ? 'true' : 'false');
    btn.dataset.voiceReady = state.ready ? 'true' : 'false';

    const label = btn.querySelector('span');
    if (label) label.textContent = state.ready ? 'Sing' : 'Loading…';
    btn.title = state.ready ? 'Toggle lyric singing' : 'Loading voice…';
  }

  function setAlbumPlayEnabled(enabled: boolean) {
    const playBtn = document.getElementById('modal-play-btn') as HTMLButtonElement | null;
    const artBtn = document.getElementById('modal-art') as HTMLElement | null;

    if (playBtn) {
      playBtn.disabled = !enabled;
      playBtn.style.opacity = enabled ? '1' : '0.6';
      playBtn.style.cursor = enabled ? 'pointer' : 'not-allowed';
      playBtn.title = enabled ? 'Play / pause' : 'Loading voice…';
    }

    // Disc art uses click handler, not a <button>
    if (artBtn) {
      artBtn.style.pointerEvents = enabled ? 'auto' : 'none';
      artBtn.style.opacity = enabled ? '1' : '0.8';
      artBtn.title = enabled ? 'Click to play / pause' : 'Loading voice…';
    }
  }

  function computeVoiceReady() {
    if (!canSpeakLyrics()) return false;
    try {
      const voices = window.speechSynthesis.getVoices();
      return Array.isArray(voices) && voices.length > 0;
    } catch {
      return false;
    }
  }

  function initVoiceReadiness() {
    if (!canSpeakLyrics()) {
      lyricVoiceReady = false;
      setVoiceToggleUI({ ready: false, enabled: false });
      // If speech isn't supported, don't block playback.
      setAlbumPlayEnabled(true);
      return;
    }

    const update = () => {
      lyricVoiceReady = computeVoiceReady();
      setVoiceToggleUI({ ready: lyricVoiceReady, enabled: lyricVoiceEnabled });
      setAlbumPlayEnabled(lyricVoiceReady);
    };

    // Kick off voice loading; many browsers populate voices async.
    update();
    try {
      window.speechSynthesis.onvoiceschanged = () => update();
      // Some browsers never fire onvoiceschanged unless getVoices() is called repeatedly at least once.
      setTimeout(update, 200);
      setTimeout(update, 800);
      setTimeout(update, 1500);
    } catch {
      /* noop */
    }
  }

  function stopLyricVoice() {
    if (!canSpeakLyrics()) return;
    try {
      window.speechSynthesis.cancel();
    } catch {
      /* noop */
    }
  }

  function speakLyricLine(text: string) {
    if (!lyricVoiceEnabled) return;
    if (!albumPlaying) return;
    if (!text) return;
    if (!canSpeakLyrics() || !lyricVoiceReady) return;

    const clean = text.trim();
    if (!clean) return;
    // Avoid re-speaking the same line (e.g. during ScrollTrigger/progress sync)
    if (clean === lastSpokenLine) return;
    lastSpokenLine = clean;

    try {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(clean);
      u.lang = 'en-US';
      // Slightly musical cadence; tweak later if you want more/less "singy"
      u.rate = 1.03;
      u.pitch = 1.08;
      u.volume = 1;
      window.speechSynthesis.speak(u);
    } catch {
      /* noop */
    }
  }

  function loadLyricVoicePref() {
    try {
      const v = localStorage.getItem(VOICE_KEY);
      lyricVoiceEnabled = v === '1';
    } catch {
      lyricVoiceEnabled = false;
    }
  }

  function saveLyricVoicePref(enabled: boolean) {
    try {
      localStorage.setItem(VOICE_KEY, enabled ? '1' : '0');
    } catch {
      /* noop */
    }
  }

  // ── Queue drawer state ──
  const QUEUE_KEY = 'dean.projectQueue.v1';
  let memoryQueueIds: string[] | null = null;

  type Project = typeof projects[number];

  function safeParseJSON<T>(value: string | null): T | null {
    if (!value) return null;
    try {
      return JSON.parse(value) as T;
    } catch {
      return null;
    }
  }

  function defaultQueueIds() {
    return projects.map((p) => p.id);
  }

  function storageGet(key: string) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function storageSet(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
      return true;
    } catch {
      return false;
    }
  }

  function loadQueueIds() {
    if (memoryQueueIds?.length) return memoryQueueIds;

    const parsed = safeParseJSON<string[]>(storageGet(QUEUE_KEY));
    const allIds = new Set(projects.map((p) => p.id));
    if (!parsed?.length) return defaultQueueIds();
    const filtered = parsed.filter((id) => allIds.has(id));
    // Ensure all projects appear at least once
    for (const id of defaultQueueIds()) if (!filtered.includes(id)) filtered.push(id);
    return filtered;
  }

  function saveQueueIds(ids: string[]) {
    const ok = storageSet(QUEUE_KEY, JSON.stringify(ids));
    if (!ok) memoryQueueIds = ids;
  }

  function openQueue() {
    if (!document.body.classList.contains('album-view-active')) return;
    document.body.classList.add('album-queue-open');
    const toggle = document.getElementById('album-queue-toggle');
    toggle?.setAttribute('aria-expanded', 'true');
    updateQueueUI();
  }

  function closeQueue() {
    document.body.classList.remove('album-queue-open');
    const toggle = document.getElementById('album-queue-toggle');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function isQueueOpen() {
    return document.body.classList.contains('album-queue-open');
  }

  function queueItemHTML(p: Project, opts: { active?: boolean; removable?: boolean }) {
    const active = opts.active ? ' q-active' : '';
    const art = p.image
      ? `<img src="${p.image}" alt="" loading="lazy" decoding="async" />`
      : `<div class="q-art-fallback" style="background:${p.gradient};"><span>${p.title[0]}</span></div>`;

    const removeBtn = opts.removable
      ? `<button class="q-icon js-q-remove" type="button" title="Remove from queue" aria-label="Remove from queue" data-id="${p.id}">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M19 13H5v-2h14v2z"/></svg>
        </button>`
      : '';

    return `
      <div class="q-item${active} js-q-open" data-id="${p.id}" role="button" tabindex="0">
        <div class="q-art">${art}</div>
        <div class="q-meta">
          <p class="q-title">${p.title}</p>
          <p class="q-sub">${p.type} · ${p.year}</p>
        </div>
        <div class="q-actions">
          ${removeBtn}
          <button class="q-icon" type="button" title="Open" aria-label="Open">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>
    `;
  }

  function updateQueueUI() {
    if (!document.body.classList.contains('album-view-active')) return;

    const nowEl = document.getElementById('album-queue-now-item');
    const listEl = document.getElementById('album-queue-list');
    if (!nowEl || !listEl) return;

    const ids = loadQueueIds();
    const currentId = currentAlbumId || ids[0] || null;
    const current = currentId ? projects.find((p) => p.id === currentId) : null;

    if (current) {
      nowEl.innerHTML = queueItemHTML(current, { active: true, removable: false });
    } else {
      nowEl.innerHTML = `<div style="padding:10px 12px;color:var(--sp-text);font-size:0.82rem;">No project selected.</div>`;
    }

    const upNext = ids.filter((id) => id !== currentId).map((id) => projects.find((p) => p.id === id)).filter(Boolean) as Project[];
    listEl.innerHTML = upNext.map((p) => queueItemHTML(p, { active: false, removable: true })).join('');

    // wire events (delegated)
    listEl.querySelectorAll('.js-q-open').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id;
        if (!id) return;
        openAlbum(id);
        if (window.matchMedia('(max-width: 860px)').matches) closeQueue();
      });
      el.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        (el as HTMLElement).click();
      });
    });

    listEl.querySelectorAll('.js-q-remove').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        if (!id) return;
        const next = loadQueueIds().filter((x) => x !== id);
        saveQueueIds(next.length ? next : defaultQueueIds());
        updateQueueUI();
      });
    });
  }

  function resetQueue() {
    saveQueueIds(defaultQueueIds());
    updateQueueUI();
  }

  function getAlbumLyricsRoot() {
    return document.getElementById('modal-lyrics-card');
  }

  function getAlbumLyricsElements() {
    const root = getAlbumLyricsRoot();
    const container = root?.querySelector('.lyrics-container') as HTMLElement | null;
    const lines = container?.querySelectorAll('.lyric-line') as NodeListOf<HTMLElement> | undefined;
    return { root, container, lines };
  }

  function syncAlbumProgressFromLyricIndex(idx: number) {
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;

    const fill = document.getElementById('album-progress-fill');
    const elapsed = document.getElementById('progress-elapsed');
    const total = document.getElementById('progress-total');
    if (!fill || !elapsed || !total) return;

    const pct = lines.length > 1 ? idx / (lines.length - 1) : 0;
    fill.style.width = `${pct * 100}%`;
    const totalSecs = (window as any).albumTotalSecs || lines.length * 4;
    const elapsedSecs = Math.floor(pct * totalSecs);
    elapsed.textContent = `${Math.floor(elapsedSecs / 60)}:${String(elapsedSecs % 60).padStart(2, '0')}`;
    total.textContent = `${Math.floor(totalSecs / 60)}:${String(totalSecs % 60).padStart(2, '0')}`;
  }

  function setAlbumLyricIndex(idx: number) {
    const { container, lines } = getAlbumLyricsElements();
    if (!container || !lines?.length) return;
    currentLyricIdx = idx;
    activateLyricLine(container, lines, lines[idx] as HTMLElement);
    syncAlbumProgressFromLyricIndex(idx);
    speakLyricLine((lines[idx] as HTMLElement)?.textContent || '');
  }

  function stopLyricTimer() {
    if (lyricTimer) {
      clearInterval(lyricTimer);
      lyricTimer = null;
    }
    stopLyricVoice();
  }

  function startLyricTimer() {
    stopLyricTimer();
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;

    lyricTimer = setInterval(() => {
      currentLyricIdx++;
      if (currentLyricIdx >= lines.length) currentLyricIdx = 0;
      setAlbumLyricIndex(currentLyricIdx);
    }, 4000);
  }

  (window as any).updateModalLyrics = function (fraction: number) {
    const root = getAlbumLyricsRoot();
    if (!root) return;
    const idx = syncLyricsFromFraction(root, fraction);
    currentLyricIdx = idx;
    syncAlbumProgressFromLyricIndex(idx);
    const { lines } = getAlbumLyricsElements();
    if (lines?.length) speakLyricLine((lines[idx] as HTMLElement)?.textContent || '');
  };

  (window as any).seekToLyric = function (index: number) {
    setAlbumLyricIndex(index);
    if (albumPlaying) startLyricTimer();
  };

  function togglePlay() {
    const rotator = document.getElementById('disc-rotator');
    const btn = document.getElementById('modal-play-btn');
    const { lines } = getAlbumLyricsElements();
    if (!rotator || !lines?.length) return;

    albumPlaying = !albumPlaying;

    if (albumPlaying) {
      rotator.classList.add('playing');
      if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" fill="black" width="24" height="24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      if (currentLyricIdx >= lines.length) currentLyricIdx = 0;
      setAlbumLyricIndex(currentLyricIdx);
      startLyricTimer();
    } else {
      rotator.classList.remove('playing');
      if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" fill="black" width="24" height="24"><path d="M8 5v14l11-7z"/></svg>';
      stopLyricTimer();
    }
  }

  // ── Play button toggle ──
  document.getElementById('modal-play-btn')?.addEventListener('click', togglePlay);
  document.getElementById('modal-art')?.addEventListener('click', togglePlay);

  // ── Progress bar seek ──
  const progressTrack = document.getElementById('progress-track');
  progressTrack?.addEventListener('click', function(e) {
    const rect = this.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    const { lines } = getAlbumLyricsElements();
    if (!lines?.length) return;
    const idx = lyricIndexFromFraction(lines.length, pct);
    (window as any).seekToLyric(idx);
  });

  // Close album overlay when navigating elsewhere (do not hijack scroll target)
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.sb-nav-link, .sb-lib-item, #sb-home-link').forEach((link) => {
      link.addEventListener('click', () => {
        if (!document.body.classList.contains('album-view-active')) return;
        closeAlbum({ scrollToProjects: false });
      });
    });
  });

  // Make functions global
  (window as any).openAlbum = openAlbum;
  (window as any).closeAlbum = closeAlbum;

  // ESC to close (queue first, then album)
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (isQueueOpen()) {
      closeQueue();
      return;
    }
    stopLyricTimer();
    albumPlaying = false;
    closeAlbum();
  });

  document.getElementById('album-share-lyrics-btn')?.addEventListener('click', async () => {
    const { container } = getAlbumLyricsElements();
    if (!container) return;
    const text = Array.from(container.querySelectorAll('.lyric-line'))
      .map((l) => l.textContent)
      .join('\n');
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      /* clipboard unavailable */
    }
  });

  // ── Queue drawer wiring ──
  const queueToggle = document.getElementById('album-queue-toggle');
  const queueClose = document.getElementById('album-queue-close');
  const queueOverlay = document.getElementById('album-queue-overlay');
  const resetBtn = document.getElementById('album-queue-reset');
  const voiceToggle = document.getElementById('album-voice-toggle');

  // Lenis applies transforms to the scroll content which breaks `position: fixed`
  // for descendants. Move overlay + drawer to <body> so they stay viewport-fixed.
  document.addEventListener('DOMContentLoaded', () => {
    const albumView = document.getElementById('album-detail-view');
    const mainScroll = document.getElementById('main-scroll');
    const overlay = document.getElementById('album-queue-overlay');
    const drawer = document.getElementById('album-queue-drawer');
    if (albumView && mainScroll && albumView.parentElement !== mainScroll) mainScroll.appendChild(albumView);
    if (overlay && overlay.parentElement !== document.body) document.body.appendChild(overlay);
    if (drawer && drawer.parentElement !== document.body) document.body.appendChild(drawer);

    loadLyricVoicePref();
    initVoiceReadiness();
  });

  queueToggle?.addEventListener('click', () => {
    if (!document.body.classList.contains('album-view-active')) return;
    if (isQueueOpen()) closeQueue();
    else openQueue();
  });

  queueClose?.addEventListener('click', closeQueue);
  queueOverlay?.addEventListener('click', closeQueue);
  resetBtn?.addEventListener('click', resetQueue);

  voiceToggle?.addEventListener('click', () => {
    if (!lyricVoiceReady) {
      // User clicked early; keep showing loading until voices are ready.
      initVoiceReadiness();
      return;
    }
    lyricVoiceEnabled = !lyricVoiceEnabled;
    saveLyricVoicePref(lyricVoiceEnabled);
    voiceToggle.setAttribute('aria-pressed', lyricVoiceEnabled ? 'true' : 'false');
    setVoiceToggleUI({ ready: lyricVoiceReady, enabled: lyricVoiceEnabled });
    lastSpokenLine = '';
    if (!lyricVoiceEnabled) stopLyricVoice();
    else {
      const { lines } = getAlbumLyricsElements();
      if (lines?.length) speakLyricLine((lines[currentLyricIdx] as HTMLElement)?.textContent || '');
    }
  });
</script>
