    duration: '2 months',
    accent: '#10B981',
    gradient: 'linear-gradient(135deg,#002918,#001510)',
    description: 'HR-focused tracking system for inventory and manpower with real-time updates.',
    longDesc: 'Built with NestJS backend and Next.js frontend using Prisma ORM. Tracks employee records, inventory movements, and generates automated reports.',
    tags: ['NestJS', 'Next.js', 'Prisma', 'MySQL'],
    tracks: [
      { name: 'Employee Registry', duration: '1:05' },
      { name: 'Inventory Tracker', duration: '1:50' },
      { name: 'Report Generator', duration: '0:48' },
      { name: 'Management Dashboard', duration: '1:12' },
    ],
    lyrics: [
      "Opening HR Inventory and Manpower System...",
      "Tracking records, movements, and stock levels,",
      "Prisma ORM mapping database relations,",
      "Next.js frontend querying NestJS backend services,",
      "Generating automated reports for administration,",
      "Optimizing workplace resource allocations,",
