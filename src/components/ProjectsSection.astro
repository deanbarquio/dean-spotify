  function openAlbum(id: string) {
    const p = projects.find(x => x.id === id);
    if (!p) return;

    const detailView = document.getElementById('album-detail-view')!;
    const header = document.getElementById('modal-header')!;
    const art = document.getElementById('modal-art')!;
    const glow = document.getElementById('modal-glow')!;
    const lyricsCard = document.getElementById('modal-lyrics-card')!;

    // Set gradient
    header.style.background = p.gradient;
    art.style.background = p.gradient;
    art.style.border = `1px solid ${p.accent}30`;
    glow.style.background = `radial-gradient(ellipse at 0% 0%, ${p.accent}20, transparent 60%)`;
    
    // Set specialized gradient for lyrics card reflecting the theme
    lyricsCard.style.background = `linear-gradient(180deg, ${p.accent}22 0%, #121212 100%)`;

    // Copy custom cover SVG if available
    const card = document.querySelector(`.album-card[data-id="${id}"]`);
    let svg: SVGElement | null = null;
    if (card) {
      svg = card.querySelector('svg');
      if (svg) {
        art.innerHTML = svg.outerHTML;
        // Make the svg fill the container correctly
        const modalSvg = art.querySelector('svg');
        if (modalSvg) {
          modalSvg.style.width = '100%';
          modalSvg.style.height = '100%';
          modalSvg.style.borderRadius = '6px';
        }
      }
    }

    // Set content
    document.getElementById('modal-title')!.textContent = p.title;
    document.getElementById('modal-artist')!.textContent = p.artist;
    document.getElementById('modal-meta')!.textContent = `${p.type} · ${p.year} · ${p.duration}`;
    document.getElementById('modal-desc')!.textContent = p.description;
    document.getElementById('modal-long-desc')!.textContent = p.longDesc;

    // Set types (Single or Album) based on project specs
    const typeLabel = document.getElementById('modal-type-label')!;
    typeLabel.textContent = p.type.includes('Library') || p.type.includes('System') || p.type.includes('App') ? 'Album' : 'Single';

    // Set release metadata
    const dateStr = p.year === '2025' ? 'January 15, 2025' : 'August 24, 2024';
    document.getElementById('modal-release-date')!.textContent = `Released: ${dateStr}`;
    document.getElementById('modal-copyright-1')!.textContent = `© ${p.year} Dean Barquio, under NTV360 & PSITS label.`;
    document.getElementById('modal-copyright-2')!.textContent = `℗ ${p.year} Dean Barquio under company portfolio release.`;

    // Follow button text reset
    const followBtn = document.getElementById('modal-follow-btn')!;
    followBtn.textContent = 'Follow';

    // Tags
    const tagsEl = document.getElementById('modal-tags')!;
    tagsEl.innerHTML = p.tags.map(t =>
      `<span style="font-size:0.72rem;padding:4px 10px;border-radius:6px;background:${p.accent}15;color:${p.accent};font-weight:600;border:1px solid ${p.accent}25;margin:2px;">${t}</span>`
    ).join('');

    // Tracks
    const tracksEl = document.getElementById('modal-tracks')!;
    const basePlays = p.title.length * 1238495;
    tracksEl.innerHTML = p.tracks.map((t, i) => {
      const trackPlays = Math.round(basePlays / (i + 1)).toLocaleString();
      return `
        <div style="display:grid;grid-template-columns:40px 1.5fr 1fr 60px;gap:16px;padding:12px 8px;border-radius:6px;align-items:center;cursor:pointer;transition:background 0.15s;"
          class="track-row"
          onmouseover="this.style.background='rgba(255,255,255,0.06)';this.querySelector('.tn').style.display='none';this.querySelector('.tp').style.display='flex'"
          onmouseout="this.style.background='transparent';this.querySelector('.tn').style.display='block';this.querySelector('.tp').style.display='none'">
          <div style="position:relative;display:flex;align-items:center;">
            <span class="tn" style="font-size:0.85rem;color:${i===0?p.accent:'var(--sp-text-dim)'};font-weight:600;">${String(i+1).padStart(2,'0')}</span>
            <span class="tp" style="display:none;align-items:center;"><svg viewBox="0 0 24 24" fill="white" width="14" height="14"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <div>
            <p style="font-size:0.88rem;font-weight:600;color:${i===0?p.accent:'#fff'};margin-bottom:2px;">${t.name}</p>
            <p style="font-size:0.75rem;color:var(--sp-text-dim);">${p.artist.split('·')[0].trim()}</p>
          </div>
          <span style="font-size:0.82rem;color:var(--sp-text-dim);">${trackPlays}</span>
          <span style="font-size:0.82rem;color:var(--sp-text-dim);justify-self:end;">${t.duration}</span>
        </div>
      `;
    }).join('');

    // Render dynamic lyrics
    const lyricsEl = document.getElementById('modal-lyrics-container')!;
    lyricsEl.innerHTML = p.lyrics.map((line, idx) => `
      <p class="modal-lyric-line ${idx === 0 ? 'active' : ''}" data-index="${idx}" onclick="window.seekToLyric(${idx})">${line}</p>
    `).join('');
    lyricsEl.scrollTop = 0;

    // Show detailed view & trigger routing class
    document.body.classList.add('album-view-active');
    detailView.style.display = 'block';

    // scroll the main page to the top of the new page
    const scroller = document.getElementById('main-scroll')!;
    scroller.scrollTop = 0;

    // dispatch global event to update player progress
    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }
  }

  function closeAlbum() {
    const detailView = document.getElementById('album-detail-view')!;
    document.body.classList.remove('album-view-active');
    detailView.style.display = 'none';

    // scroll back to projects section
    document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });

    // dispatch global event to reset scroll indicators
    if (typeof (window as any).updateProgress === 'function') {
      (window as any).updateProgress();
    }
  }

  // Interactive lyrics sync seek function
  (window as any).seekToLyric = function(index: number) {
    const lines = document.querySelectorAll('.modal-lyric-line');
    if (!lines.length) return;
    const fraction = (index + 0.2) / lines.length;
    
    const scroller = document.getElementById('main-scroll')!;
    const isAlbumActive = document.body.classList.contains('album-view-active');
    const baseOffset = isAlbumActive ? 0 : document.getElementById('projects')!.offsetTop;
    const scrollHeight = scroller.scrollHeight - scroller.clientHeight;
    
    scroller.scrollTo({
      top: baseOffset + (fraction * (scrollHeight - baseOffset)),
      behavior: 'smooth'
    });
  };

  // Sync scroll positioning of active lyric lines based on overall modal scroll
  (window as any).updateModalLyrics = function(fraction: number) {
    const lines = document.querySelectorAll('.modal-lyric-line');
    if (!lines.length) return;
    
    const activeIndex = Math.max(0, Math.min(lines.length - 1, Math.floor(fraction * lines.length)));
    
    lines.forEach((line, idx) => {
      const lineEl = line as HTMLElement;
      if (idx === activeIndex) {
        if (!lineEl.classList.contains('active')) {
          lineEl.classList.add('active');
          const container = document.getElementById('modal-lyrics-container')!;
          container.scrollTo({
            top: lineEl.offsetTop - (container.clientHeight / 2) + (lineEl.clientHeight / 2),
            behavior: 'smooth'
          });
        }
      } else {
        lineEl.classList.remove('active');
      }
    });
  };

  // Close album view if sidebar navigation links or logo are clicked
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.sb-nav-link, .sb-lib-item, #sb-home-link').forEach(link => {
      link.addEventListener('click', () => {
        closeAlbum();
      });
    });
  });

  // Make functions global
  (window as any).openAlbum = openAlbum;
  (window as any).closeAlbum = closeAlbum;

  // ESC to close
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAlbum(); });
</script>
