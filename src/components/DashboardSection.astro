---

<section id="dashboard" style="padding-bottom:40px;">

  <div class="dash-page-pad">

    <!-- ① Greeting + filter chips + Spotify-style quick links -->
    <header class="dash-home-header">
      <h2 id="greeting-text" class="dash-greeting">Good evening</h2>

      <div class="dash-filters" role="tablist" aria-label="Filter shortcuts">
        {filterPills.map((pill, i) => (
          <button
            type="button"
            class:list={['dash-filter-pill', 'js-dash-filter', i === 0 && 'dash-filter-pill--active']}
            data-filter={pill.id}
            role="tab"
            aria-selected={i === 0}
          >
            {pill.label}
          </button>
        ))}
      </div>

      <div class="dash-quick quick-grid">
        {quickLinks.map((item) => (
          <a
            href={item.href}
            class="dash-quick-card js-dash-quick-card"
            data-category={item.category}
            style={`--quick-accent: ${item.accent};`}
          >
            <span class="dash-quick-art" aria-hidden="true">
              {item.poster ? (
                <span class="dash-quick-poster" set:html={categoryPosters[item.poster]} />
              ) : item.image ? (
                <>
                  <img src={item.image} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  <span class="dash-quick-photo-wash"></span>
                </>
              ) : null}
              <span class="dash-quick-art-edge"></span>
            </span>
            <span class="dash-quick-copy">
              <span class="dash-quick-title">{item.title}</span>
              <span class="dash-quick-sub">{item.sub}</span>
            </span>
            <span class="dash-quick-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </a>
        ))}
      </div>
    </header>

    <!-- ④ MADE FOR YOU -->
    <section class="mfy-section" aria-label="Made For You">
      <div class="mfy-section-header">
        <h2 class="mfy-section-title">Made For You</h2>
        <a href="#projects" class="mfy-show-all">Show all</a>
      </div>
      <div class="mix-row-scroll" data-native-scroll role="list">
        {madeForYou.map((card) => (
          <a
            href="#projects"
            class="mix-card js-mfy-card"
            role="listitem"
            style={`--mix-accent: ${card.accent};`}
          >
            <div class="mix-card-cover">
              {card.cover ? (
                <img src={card.cover} alt="" loading="lazy" decoding="async" />
              ) : (
                <div class="mix-card-cover-fallback" style={`background:${card.gradient};`}>
                  <span>{card.title[0]}</span>
                </div>
              )}
              <div class="mix-card-vignette" aria-hidden="true"></div>
              <span class="mix-card-pill">Mix</span>
              <span class="mix-card-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="mix-card-body">
              <p class="mix-card-title">{card.title}</p>
              <p class="mix-card-sub">{card.sub}</p>
              <p class="mix-card-tags">{card.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ⑤ SPLIT ROW: "What You Work With" + "Now Playing" hero -->
