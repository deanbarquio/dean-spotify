---
// ContactSection.astro — Final call to action
---

<section id="contact" class="section" style="padding-bottom:80px;">
  <div class="contact-inner reveal" style="max-width:560px;margin:0 auto;text-align:center;">
    <!-- Spotify-style album icon -->
    <div style="width:120px;height:120px;border-radius:50%;background:linear-gradient(135deg,#1DB954 0%,#0d5c2e 100%);display:flex;align-items:center;justify-content:center;margin:0 auto 32px;box-shadow:0 20px 60px rgba(29,185,84,0.3);">
      <svg viewBox="0 0 24 24" fill="white" width="52" height="52"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
    </div>

    <p style="font-size:0.72rem;font-weight:700;color:var(--sp-green);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:12px;">Open to Collaboration</p>
    <h2 style="font-size:2.5rem;font-weight:800;color:var(--sp-white);letter-spacing:-0.03em;margin-bottom:16px;line-height:1.1;">Let's Make Something<br/><span class="gradient-text">Great Together</span></h2>
    <p style="font-size:0.9rem;color:var(--sp-text);line-height:1.7;margin-bottom:36px;">I'm currently open to new opportunities and collaborations. Whether you have a project in mind, a role that fits, or just want to connect — my inbox is always open.</p>

    <!-- Contact options -->
    <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:36px;">
      <a href="mailto:deanbarquio@gmail.com"
        style="display:flex;align-items:center;gap:14px;padding:16px 24px;background:var(--sp-surface);border:1px solid var(--sp-border);border-radius:10px;text-decoration:none;transition:background 0.2s,border-color 0.2s,transform 0.15s;"
        onmouseover="this.style.background='var(--sp-elevated)';this.style.borderColor='rgba(29,185,84,0.4)';this.style.transform='translateX(4px)'"
        onmouseout="this.style.background='var(--sp-surface)';this.style.borderColor='var(--sp-border)';this.style.transform='translateX(0)'"
      >
        <div style="width:40px;height:40px;border-radius:8px;background:rgba(29,185,84,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg viewBox="0 0 24 24" fill="var(--sp-green)" width="18" height="18"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </div>
        <div style="text-align:left;">
          <p style="font-size:0.7rem;color:var(--sp-text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:2px;">Email</p>
          <p style="font-size:0.88rem;font-weight:600;color:var(--sp-white);">deanbarquio@gmail.com</p>
        </div>
        <svg viewBox="0 0 24 24" fill="var(--sp-text-dim)" width="16" height="16" style="margin-left:auto;"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </a>

      <a href="tel:+639480080380"
        style="display:flex;align-items:center;gap:14px;padding:16px 24px;background:var(--sp-surface);border:1px solid var(--sp-border);border-radius:10px;text-decoration:none;transition:background 0.2s,border-color 0.2s,transform 0.15s;"
        onmouseover="this.style.background='var(--sp-elevated)';this.style.borderColor='rgba(29,185,84,0.4)';this.style.transform='translateX(4px)'"
        onmouseout="this.style.background='var(--sp-surface)';this.style.borderColor='var(--sp-border)';this.style.transform='translateX(0)'"
      >
        <div style="width:40px;height:40px;border-radius:8px;background:rgba(59,130,246,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg viewBox="0 0 24 24" fill="#3B82F6" width="18" height="18"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        </div>
        <div style="text-align:left;">
          <p style="font-size:0.7rem;color:var(--sp-text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:2px;">Phone</p>
          <p style="font-size:0.88rem;font-weight:600;color:var(--sp-white);">+63 948 008 0380</p>
        </div>
        <svg viewBox="0 0 24 24" fill="var(--sp-text-dim)" width="16" height="16" style="margin-left:auto;"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </a>
    </div>

    <!-- Social links -->
    <div class="contact-socials" style="display:flex;align-items:center;justify-content:center;gap:16px;">
      {[
        { href: 'https://github.com/deanbarquio', label: 'GitHub', svg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>` },
        { href: 'https://linkedin.com/in/deanbarquio', label: 'LinkedIn', svg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
        { href: 'https://deanbarquio-portfolio.vercel.app', label: 'Portfolio', svg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>` },
      ].map(s => (
        <a href={s.href} target="_blank" rel="noopener"
          style="display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:500px;border:1px solid var(--sp-border);color:var(--sp-text);text-decoration:none;font-size:0.8rem;font-weight:600;transition:color 0.15s,border-color 0.15s,background 0.15s;"
          onmouseover="this.style.color='#fff';this.style.borderColor='rgba(255,255,255,0.3)';this.style.background='var(--sp-elevated)'"
          onmouseout="this.style.color='var(--sp-text)';this.style.borderColor='var(--sp-border)';this.style.background='transparent'"
        >
          <span set:html={s.svg} />
          {s.label}
        </a>
      ))}
    </div>
  </div>
</section>
