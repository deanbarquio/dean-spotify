<script>
  import { initSkillsHeroCanvas, initSkillsBrowseCanvas } from '../lib/skills-three';

  const handles: { dispose: () => void }[] = [];

  const heroCanvas = document.getElementById('sk-hero-canvas') as HTMLCanvasElement | null;
  if (heroCanvas) {
    const h = initSkillsHeroCanvas(heroCanvas);
    if (h) handles.push(h);
  }

  const browseCanvas = document.getElementById('sk-browse-canvas') as HTMLCanvasElement | null;
  if (browseCanvas) {
    const b = initSkillsBrowseCanvas(browseCanvas);
    if (b) handles.push(b);
  }

  document.addEventListener('astro:before-swap', () => {
    handles.forEach((h) => h.dispose());
  });
</script>
