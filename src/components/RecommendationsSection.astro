---
import { recommendations } from '@/data/recommendations';
import { recommendationPosters } from '@/lib/recommendation-graphics';

const featured = recommendations[0];
const total = recommendations.length;
const waveHeights = Array.from({ length: 24 }, (_, i) =>
  Math.round(22 + (Math.sin(i * 0.55) + 1) * 38)
);
---

<section id="recommendations" class="rec-section">
  <header class="rec-hero reveal">
    <div class="rec-hero-noise" aria-hidden="true"></div>
    <div class="rec-hero-mesh" aria-hidden="true"></div>
    <svg class="rec-hero-orbit" viewBox="0 0 400 400" aria-hidden="true">
      <defs>
        <linearGradient id="rec-orbit-g" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#1db954" stop-opacity="0.6"/>
          <stop offset="100%" stop-color="#ec4899" stop-opacity="0.2"/>
        </linearGradient>
      </defs>
      <circle cx="320" cy="80" r="120" fill="none" stroke="url(#rec-orbit-g)" stroke-width="1" opacity="0.35"/>
      <circle cx="320" cy="80" r="88" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="6 10"/>
      <path d="M280 40 Q360 120 300 200" fill="none" stroke="rgba(29,185,84,0.25)" stroke-width="2"/>
      <g opacity="0.5">
        <rect x="48" y="48" width="8" height="8" fill="#1db954" transform="rotate(45 52 52)"/>
        <rect x="72" y="120" width="6" height="6" fill="#ec4899" transform="rotate(20 75 123)"/>
        <rect x="340" y="200" width="10" height="10" fill="#60a5fa" transform="rotate(-12 345 205)"/>
      </g>
    </svg>
    <div class="rec-hero-vignette" aria-hidden="true"></div>

    <div class="rec-hero-layout">
      <div class="rec-hero-inner">
        <p class="rec-eyebrow">
          <span class="rec-eq" aria-hidden="true">
            <span class="rec-eq-bar"></span><span class="rec-eq-bar"></span>
            <span class="rec-eq-bar"></span><span class="rec-eq-bar"></span>
          </span>
          Playlist · Testimonials
        </p>
        <h2 class="rec-title">Recommendations</h2>
        <p class="rec-meta">
          <span class="rec-meta-artist">Dean Barquio</span>
          <span class="rec-meta-sep">·</span>
          {total} reviews
          <span class="rec-meta-sep">·</span>
          N-Compass TV
        </p>
        <p class="rec-desc">Voices from designers, QA, and engineers who worked alongside Dean.</p>
        <div class="rec-hero-actions">
          <button type="button" class="rec-btn-play" aria-label="Play testimonials">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button type="button" class="rec-btn-icon" aria-label="Shuffle">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5z"/></svg>
          </button>
          <span class="rec-hero-stat">
            <svg viewBox="0 0 24 24" fill="#1db954" width="14" height="14"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            5.0 · LinkedIn
          </span>
        </div>
      </div>

      <div class="rec-hero-collage" aria-hidden="true">
        {recommendations.map((rec, i) => (
          <div
            class="rec-collage-tile"
            style={`--rec-accent: ${rec.accent}; --tile-i: ${i};`}
          >
            <span class="rec-collage-poster" set:html={recommendationPosters[rec.poster]} />
            <span class="rec-collage-initials">{rec.initials}</span>
          </div>
        ))}
      </div>
    </div>
  </header>

  <article
    class="rec-featured js-rec-featured"
    data-rec-id={featured.id}
    style={`--rec-accent: ${featured.accent};`}
    aria-labelledby={`rec-title-${featured.id}`}
  >
    <div class="rec-card-art">
      <span class="rec-card-poster" set:html={recommendationPosters[featured.poster]} />
      <div class="rec-vinyl-ring" aria-hidden="true">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <circle cx="100" cy="100" r="96" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="2"/>
          <circle cx="100" cy="100" r="72" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" stroke-dasharray="4 8"/>
          <circle cx="100" cy="100" r="48" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="14" fill="rgba(18,18,18,0.9)" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
        </svg>
      </div>
      <div class="rec-card-art-overlay" aria-hidden="true"></div>
      <span class="rec-card-initials">{featured.initials}</span>
      <span class="rec-quote-deco" aria-hidden="true">"</span>
      <div class="rec-spectrum-deco" aria-hidden="true">
        {Array.from({ length: 12 }).map((_, i) => (
          <span class="rec-spectrum-bar" style={`--sp-i: ${i};`}></span>
        ))}
      </div>
      <div class="rec-waveform" aria-hidden="true">
        {waveHeights.map((h, i) => (
          <span class="rec-wave-bar" style={`--wave-h: ${h}%; --i: ${i};`}></span>
        ))}
      </div>
    </div>

    <div class="rec-card-body">
      <div class="rec-card-head">
        <div class="rec-card-who">
          <h3 id={`rec-title-${featured.id}`} class="rec-card-name">
            {featured.name}
            <span class="rec-verified" title="LinkedIn recommendation">
              <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5l-1.41-1.41L10 13.17l1.59 1.59L16 10.59 17.41 12 12 17.5z"/></svg>
            </span>
          </h3>
          <p class="rec-card-role">{featured.title}</p>
          <p class="rec-card-context">
            <span class="rec-li-badge">
              <svg viewBox="0 0 24 24" fill="currentColor" width="10" height="10"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z"/></svg>
              LinkedIn
            </span>
            <span class="rec-card-date">{featured.date}</span>
            <span class="rec-meta-sep">·</span>
            {featured.context}
          </p>
          <div class="rec-tags">
            {featured.tags.map((tag) => (
              <span class="rec-tag">{tag}</span>
            ))}
          </div>
        </div>
        <span class="rec-card-badge">Now playing</span>
      </div>
      <div class="rec-quote js-rec-quote">
        {featured.quote.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <div class="rec-progress" aria-hidden="true">
        <span class="rec-progress-track">
          <span class="rec-progress-fill"></span>
        </span>
        <span class="rec-progress-time">0:42</span>
        <span class="rec-progress-time rec-progress-time--end">∞ trust</span>
      </div>
    </div>
  </article>

  <div class="rec-row-header">
    <h3 class="rec-row-title">
      <span class="rec-row-eq" aria-hidden="true">
        {Array.from({ length: 5 }).map((_, i) => (
          <span class="rec-row-eq-bar" style={`--eq-i: ${i};`}></span>
        ))}
      </span>
      All reviews
    </h3>
    <span class="rec-row-count">{total} episodes</span>
  </div>

  <div class="rec-scroll" data-native-scroll role="list">
    {recommendations.map((rec, i) => (
      <button
        type="button"
        class="rec-card js-rec-card"
        role="listitem"
        data-rec-id={rec.id}
        style={`--rec-accent: ${rec.accent};`}
        aria-pressed={rec.id === featured.id ? 'true' : 'false'}
      >
        <span class="rec-card-index">{i + 1}</span>
        <div class="rec-card-thumb">
          <span class="rec-card-poster rec-card-poster--sm" set:html={recommendationPosters[rec.poster]} />
          <span class="rec-card-initials rec-card-initials--sm">{rec.initials}</span>
          <span class="rec-thumb-wave" aria-hidden="true">
            {Array.from({ length: 8 }).map((_, wi) => (
              <span class="rec-thumb-wave-bar" style={`--wi: ${wi}; --wh: ${30 + ((wi * 7 + i * 3) % 50)}%;`}></span>
            ))}
          </span>
        </div>
        <div class="rec-card-mini">
          <p class="rec-card-name">{rec.name}</p>
          <p class="rec-card-role">{rec.title}</p>
          <p class="rec-card-excerpt">{rec.quote[0]}</p>
        </div>
        <span class="rec-card-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    ))}
  </div>
</section>

<script>
  import { recommendations } from '@/data/recommendations';
  import { recommendationPosters } from '@/lib/recommendation-graphics';
  import gsap from 'gsap';

  const recById = Object.fromEntries(recommendations.map((r) => [r.id, r]));

  function setFeatured(id: string) {
    const rec = recById[id];
    if (!rec) return;

    const featuredEl = document.querySelector('.js-rec-featured');
    if (!featuredEl) return;

    const poster = featuredEl.querySelector('.rec-card-art .rec-card-poster');
    const initials = featuredEl.querySelector('.rec-card-art .rec-card-initials');
    const name = featuredEl.querySelector('.rec-card-who .rec-card-name');
    const role = featuredEl.querySelector('.rec-card-who .rec-card-role');
    const context = featuredEl.querySelector('.rec-card-context');
    const tags = featuredEl.querySelector('.rec-tags');
    const quote = featuredEl.querySelector('.js-rec-quote');
    const titleId = featuredEl.querySelector('.rec-card-name');

    featuredEl.setAttribute('data-rec-id', id);
    featuredEl.style.setProperty('--rec-accent', rec.accent);
    if (titleId) titleId.id = `rec-title-${id}`;

    if (poster) poster.innerHTML = recommendationPosters[rec.poster] ?? '';
    if (initials) initials.textContent = rec.initials;
    if (name) {
      name.innerHTML = `${rec.name}<span class="rec-verified" title="LinkedIn recommendation"><svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5l-1.41-1.41L10 13.17l1.59 1.59L16 10.59 17.41 12 12 17.5z"/></svg></span>`;
    }
    if (role) role.textContent = rec.title;
    if (context) {
      const li = context.querySelector('.rec-li-badge');
      const liHtml = li ? li.outerHTML : '';
      context.innerHTML = `${liHtml}<span class="rec-card-date">${rec.date}</span><span class="rec-meta-sep">·</span>${rec.context}`;
    }
    if (tags) {
      tags.innerHTML = rec.tags.map((t) => `<span class="rec-tag">${t}</span>`).join('');
    }
    if (quote) {
      quote.innerHTML = rec.quote.map((p) => `<p>${p}</p>`).join('');
    }

    document.querySelectorAll('.rec-scroll .js-rec-card').forEach((card) => {
      const active = card.getAttribute('data-rec-id') === id;
      card.classList.toggle('rec-card--active', active);
      card.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    const art = featuredEl.querySelector('.rec-card-art');
    if (art) {
      gsap.fromTo(art, { scale: 0.94, filter: 'brightness(0.7)' }, { scale: 1, filter: 'brightness(1)', duration: 0.45, ease: 'power2.out' });
    }
    if (quote) {
      gsap.fromTo(quote.children, { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, stagger: 0.06, ease: 'power2.out' });
    }
  }

  function initRecCards() {
    document.querySelectorAll<HTMLButtonElement>('.rec-scroll .js-rec-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-rec-id');
        if (id) setFeatured(id);
      });
    });
  }

  initRecCards();

  document.addEventListener('astro:page-load', () => {
    initRecCards();
  });
</script>

<style>
  .rec-section {
    padding: 32px var(--page-pad-x, 16px) 56px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    position: relative;
  }

  .rec-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 100%);
    height: 400px;
    background: radial-gradient(ellipse at 50% 0%, rgba(29, 185, 84, 0.08), transparent 70%);
    pointer-events: none;
  }

  /* ── Hero (Spotify show page) ── */
  .rec-hero {
    position: relative;
    min-height: 280px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 28px;
    background: linear-gradient(160deg, #0a1f12 0%, #121212 38%, #1a0a28 72%, #0d0d0d 100%);
    isolation: isolate;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }

  .rec-hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1;
  }

  .rec-hero-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 85% 20%, rgba(236, 72, 153, 0.18), transparent),
      radial-gradient(ellipse 60% 50% at 10% 80%, rgba(29, 185, 84, 0.15), transparent);
    z-index: 1;
    pointer-events: none;
  }

  .rec-hero-orbit {
    position: absolute;
    top: -20%;
    right: -8%;
    width: min(420px, 70%);
    height: auto;
    aspect-ratio: 1;
    z-index: 1;
    pointer-events: none;
    opacity: 0.85;
    animation: rec-orbit-spin 48s linear infinite;
  }

  @keyframes rec-orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .rec-hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(18, 18, 18, 0.85) 0%, transparent 40%),
      linear-gradient(90deg, rgba(18, 18, 18, 0.75) 0%, transparent 55%);
    z-index: 2;
    pointer-events: none;
  }

  .rec-hero-layout {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 24px 18px 20px;
    min-height: 280px;
    align-items: end;
  }

  .rec-hero-inner {
    max-width: 100%;
  }

  .rec-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sp-green);
    margin-bottom: 12px;
  }

  .rec-eq {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .rec-eq-bar {
    width: 3px;
    background: var(--sp-green);
    border-radius: 1px;
    animation: rec-eq 0.7s ease-in-out infinite alternate;
    transform-origin: bottom;
  }
  .rec-eq-bar:nth-child(1) { height: 6px; animation-delay: 0s; }
  .rec-eq-bar:nth-child(2) { height: 12px; animation-delay: 0.15s; }
  .rec-eq-bar:nth-child(3) { height: 4px; animation-delay: 0.08s; }
  .rec-eq-bar:nth-child(4) { height: 10px; animation-delay: 0.22s; }

  @keyframes rec-eq {
    from { transform: scaleY(0.35); }
    to { transform: scaleY(1); }
  }

  .rec-title {
    font-size: clamp(2rem, 8vw, 3.25rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 0 0 12px;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.4);
  }

  .rec-meta {
    font-size: 0.8125rem;
    color: var(--sp-text);
    margin-bottom: 10px;
  }

  .rec-meta-artist {
    color: #fff;
    font-weight: 600;
  }

  .rec-meta-sep {
    margin: 0 6px;
    color: var(--sp-text-dim);
  }

  .rec-desc {
    font-size: 0.8125rem;
    color: var(--sp-text-dim);
    line-height: 1.55;
    margin: 0 0 18px;
    max-width: 420px;
  }

  .rec-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .rec-btn-play {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background: var(--sp-green);
    color: #121212;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 28px rgba(29, 185, 84, 0.45);
    transition: transform 0.15s ease;
  }
  .rec-btn-play:hover {
    transform: scale(1.06);
  }

  .rec-btn-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: var(--sp-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .rec-btn-icon:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .rec-hero-stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sp-text);
    padding: 8px 14px;
    border-radius: 500px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .rec-hero-collage {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    max-width: 100%;
  }

  .rec-collage-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transform: rotate(calc((var(--tile-i) - 2) * 3deg));
    transition: transform 0.25s ease;
  }

  .rec-collage-tile:hover {
    transform: rotate(0deg) scale(1.05);
    z-index: 2;
  }

  .rec-collage-poster {
    position: absolute;
    inset: 0;
    display: block;
  }

  .rec-collage-poster :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .rec-collage-initials {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    z-index: 1;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.5) 100%);
  }

  /* ── Featured (now playing) ── */
  .rec-featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(24, 24, 24, 0.95));
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 28px;
    text-align: left;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 24px 56px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: box-shadow 0.3s ease;
  }

  .rec-featured:hover {
    box-shadow:
      0 28px 64px rgba(0, 0, 0, 0.55),
      0 0 0 1px color-mix(in srgb, var(--rec-accent, #1db954) 35%, transparent);
  }

  .rec-card-art {
    position: relative;
    min-height: 200px;
    overflow: hidden;
    isolation: isolate;
  }

  .rec-card-poster {
    position: absolute;
    inset: 0;
    display: block;
  }

  .rec-card-poster :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rec-vinyl-ring {
    position: absolute;
    inset: -15%;
    z-index: 0;
    opacity: 0.55;
    animation: rec-vinyl-spin 24s linear infinite;
    pointer-events: none;
  }

  .rec-vinyl-ring svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes rec-vinyl-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .rec-spectrum-deco {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    height: 56%;
    justify-content: space-between;
    pointer-events: none;
    opacity: 0.7;
  }

  .rec-spectrum-bar {
    width: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--rec-accent, #1db954) 70%, #fff);
    height: calc(20% + (var(--sp-i) * 5%));
    animation: rec-spectrum 0.6s ease-in-out infinite alternate;
    animation-delay: calc(var(--sp-i) * 0.05s);
  }

  @keyframes rec-spectrum {
    from { transform: scaleY(0.35); opacity: 0.45; }
    to { transform: scaleY(1); opacity: 1; }
  }

  .rec-card-art-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 20%,
      rgba(0, 0, 0, 0.55) 70%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .rec-card-art .rec-card-initials {
