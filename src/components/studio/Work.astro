---
// Work.astro — asymmetric 12-col grid of square tiles; each opens its case page
import { projects } from '../../data/portfolio';

const order = ['fenghuang', 'fire-and-blood', 'constrack', 'control-panel', 'hikemate', 'psits', 'buildit', 'meeting-room', 'component-pantry', 'ntv-dashboard'];
const list = order.map((id) => projects.find((p) => p.id === id)!).filter(Boolean);
---

<section class="work" id="work" aria-label="Selected work">
  <h2 class="sr-only">Selected work</h2>
  <div class="work-grid grid12">
    {list.map((p, i) => (
      <article class={`tile tile--${i + 1}`} data-tile>
        <a href={`/work/${p.id}`} class="tile-link" aria-label={`${p.title} - ${p.year}`}>
          <div class="square tile-media" style={`--paint:${p.paint}`}>
            {i < 4 && <span class="chip-accent">{p.kind}</span>}
            {p.image ? (
              <img src={p.image} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            ) : (
              <div class="poster" aria-hidden="true"><span class="wide">{p.title}</span></div>
            )}
          </div>
          <div class="tile-meta">
            <span class="tile-title" data-scramble>{p.title}</span>
            <span class="tile-info mono-2">
              <span>{p.year}</span>
              {p.url && <span class="tile-ext">live <span aria-hidden="true">↗</span></span>}
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>
