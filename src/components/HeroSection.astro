---
// HeroSection.astro — cinematic "Now Playing" hero with a 3D DJ stage
// Model: "Monkey DJ (Animated)" by Jungle Jim (CC-BY-4.0) → public/models/monkey-dj.glb
---

<!-- Opening title card (full viewport, only on first visit per session) -->
<div class="intro-card" id="intro-card" aria-hidden="true">
  <div class="intro-card-grain"></div>
  <div class="intro-card-inner">
    <p class="intro-card-kicker">Dean.dev presents</p>
    <p class="intro-card-title">A <span>Dean Barquio</span> Production</p>
    <div class="intro-card-load"><span id="intro-card-bar"></span></div>
    <p class="intro-card-status" id="intro-card-status">Setting up the decks…</p>
  </div>
</div>

<section id="home" class="hero-section">
  <!-- Stage: CSS poster first, WebGL on top once the model streams in -->
  <div class="hero-poster" aria-hidden="true"></div>
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="hero-letterbox hero-letterbox--top" aria-hidden="true"></div>
  <div class="hero-letterbox hero-letterbox--bottom" aria-hidden="true"></div>

  <button type="button" class="hero-skip" id="hero-skip">Skip intro</button>

  <!-- Hero Content -->
  <div id="hero-content" class="hero-content">

    <!-- Now Playing badge -->
    <div class="hero-badge" data-intro>
      <span class="hero-eq" aria-hidden="true">
        <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
      </span>
      <span>Now Playing</span>
    </div>

    <!-- Name -->
    <h1 class="hero-name">
      <span class="hero-line"><span data-intro-line>Dean Lourence</span></span>
      <span class="hero-line"><span data-intro-line class="gradient-text">P. Barquio</span></span>
    </h1>

    <!-- Role -->
    <p class="hero-role" data-intro>
      <span>Software Engineer</span> &amp; Frontend Developer
    </p>

    <!-- Location + contact -->
    <div class="hero-meta" data-intro>
      <span class="hero-meta-item">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Consolacion, Cebu
      </span>
      <span class="hero-meta-sep">·</span>
      <a href="mailto:deanbarquio@gmail.com" class="hero-meta-item hero-meta-link">deanbarquio@gmail.com</a>
      <span class="hero-meta-sep">·</span>
      <span class="hero-meta-item">+63 948 008 0380</span>
    </div>

    <!-- CTA buttons -->
    <div class="hero-ctas" data-intro>
      <a href="#projects" class="btn-primary hero-cta">
        <svg viewBox="0 0 24 24" fill="black" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        View Projects
      </a>
      <a href="#contact" class="btn-outline hero-cta">Get in Touch</a>
    </div>

    <!-- Stats row -->
    <div class="hero-stats" data-intro>
      {[
        { num: '5+', label: 'Projects Built' },
        { num: '1yr+', label: 'Experience' },
        { num: '10+', label: 'Tech Stack' },
        { num: 'Magna', label: 'Cum Laude' },
      ].map(s => (
        <div>
          <p class="hero-stat-num">{s.num}</p>
          <p class="hero-stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-footer" data-intro-late>
    <span class="hero-scroll-cue"><span></span>Scroll</span>
    <p class="hero-credit">
      Stage: <a href="https://sketchfab.com/3d-models/monkey-dj-animated-dfa60c2109bb4723b8b10ae52a98f85e" target="_blank" rel="noopener">Monkey DJ (Animated)</a>
      by <a href="https://sketchfab.com/jungle_jim" target="_blank" rel="noopener">Jungle Jim</a>,
      <a href="http://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
    </p>
  </div>
</section>

<style>
  /* ── Title card ── */
  .intro-card {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    pointer-events: none;
  }
  :global(html.intro-playing:not(.intro-short)) .intro-card {
    display: flex;
  }
  .intro-card-grain,
  .hero-grain {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    opacity: 0.09;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    animation: grain 0.6s steps(4) infinite;
  }
  @keyframes grain {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-3%, 2%); }
    50% { transform: translate(2%, -3%); }
    75% { transform: translate(-1%, -2%); }
    100% { transform: translate(3%, 1%); }
  }
  .intro-card-inner {
    position: relative;
    text-align: center;
    padding: 0 24px;
  }
  .intro-card-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--sp-green);
    margin-bottom: 14px;
  }
  .intro-card-title {
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .intro-card-title span {
    font-weight: 800;
    color: #fff;
  }
  .intro-card-load {
    width: min(220px, 60vw);
    height: 2px;
    margin: 28px auto 10px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .intro-card-load span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--sp-green);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  .intro-card-status {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ── Hide app chrome while the intro plays ── */
  :global(html.intro-playing .sidebar),
  :global(html.intro-playing .player-bar),
  :global(html.intro-playing .main-topbar) {
    opacity: 0;
    pointer-events: none;
  }
  :global(html.intro-playing .sidebar) { translate: -24px 0; }
  :global(html.intro-playing .player-bar) { translate: 0 24px; }
  :global(html.intro-playing .main-topbar) { translate: 0 -16px; }
  :global(html.intro-reveal .sidebar),
  :global(html.intro-reveal .player-bar),
  :global(html.intro-reveal .main-topbar) {
    transition: opacity 0.9s ease, translate 0.9s cubic-bezier(0.22, 1, 0.36, 1) !important;
  }
  /* Hero copy waits for the reveal */
  :global(html.intro-playing) [data-intro],
  :global(html.intro-playing) [data-intro-late] {
    opacity: 0;
  }
  /* Name lines rise out of their mask: pure CSS, so nothing can strand them off-screen */
  :global(html.intro-playing) [data-intro-line] {
    transform: translateY(110%);
  }
  :global(html.intro-reveal) [data-intro-line] {
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }
  :global(html.intro-reveal) .hero-line + .hero-line [data-intro-line] {
    transition-delay: 0.3s;
  }

  /* ── Hero stage ── */
  .hero-section {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #050605;
  }
  .hero-poster {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(40% 55% at 72% 38%, rgba(139, 92, 246, 0.22), transparent 70%),
      radial-gradient(45% 60% at 58% 30%, rgba(29, 185, 84, 0.2), transparent 70%),
      radial-gradient(70% 40% at 65% 100%, rgba(29, 185, 84, 0.12), transparent 70%),
      #050605;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .hero-section.is-stage-ready .hero-canvas {
    opacity: 1;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 6, 5, 0.95) 0%, rgba(5, 6, 5, 0.85) 38%, rgba(5, 6, 5, 0.4) 55%, rgba(5, 6, 5, 0) 68%),
      linear-gradient(0deg, var(--sp-bg) 0%, rgba(18, 18, 18, 0) 22%);
  }
  .hero-grain {
    z-index: 3;
    opacity: 0.05;
  }
  .hero-letterbox {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 4;
    height: 11%;
    background: #000;
    pointer-events: none;
    transform: scaleY(0);
  }
  .hero-letterbox--top { top: 0; transform-origin: top; }
  .hero-letterbox--bottom { bottom: 0; transform-origin: bottom; }
  :global(html.intro-playing) .hero-letterbox {
    transform: scaleY(1);
  }

  .hero-skip {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1001;
    display: none;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  :global(html.intro-playing) .hero-skip {
    display: inline-flex;
  }
  .hero-skip:hover { border-color: #fff; }
  .hero-skip:focus-visible { outline: 2px solid var(--sp-green); outline-offset: 2px; }

  /* ── Copy ── */
  .hero-content {
    position: relative;
    z-index: 5;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(29, 185, 84, 0.1);
    border: 1px solid rgba(29, 185, 84, 0.25);
    border-radius: 500px;
    padding: 6px 16px;
    margin-bottom: 32px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sp-green);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    backdrop-filter: blur(6px);
  }
  .hero-eq {
    display: flex;
    gap: 2px;
    align-items: flex-end;
    height: 14px;
  }
  .eq-bar {
    width: 3px;
    height: 14px;
    background: var(--sp-green);
    border-radius: 1px;
    animation: eq 0.5s ease-in-out infinite alternate; /* 120 BPM, in time with the stage */
    transform-origin: bottom;
  }
  .eq-bar:nth-child(2) { animation-delay: -0.2s; }
  .eq-bar:nth-child(3) { animation-delay: -0.35s; }
  .eq-bar:nth-child(4) { animation-delay: -0.1s; }
  @keyframes eq {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--sp-white);
    margin-bottom: 16px;
  }
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero-line > span {
    display: inline-block;
  }
  .hero-role {
    font-size: 1.125rem;
    color: var(--sp-text);
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .hero-role span {
    color: var(--sp-green);
    font-weight: 600;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .hero-meta-item,
  .hero-meta-sep {
    font-size: 0.8rem;
    color: var(--sp-text-dim);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-meta-link {
    text-decoration: none;
    transition: color 0.15s;
  }
  .hero-meta-link:hover { color: var(--sp-green); }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-cta {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hero-stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--sp-white);
    letter-spacing: -0.02em;
  }
  .hero-stat-label {
    font-size: 0.72rem;
    color: var(--sp-text-dim);
    font-weight: 500;
    margin-top: 2px;
  }

  .hero-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 var(--page-pad-x, 16px);
    pointer-events: none;
  }
  .hero-scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sp-text-dim);
  }
  .hero-scroll-cue span {
    width: 1px;
    height: 28px;
    background: linear-gradient(var(--sp-green), transparent);
    animation: cue 1.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(1); opacity: 0; }
  }
  .hero-credit {
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.35);
    text-align: right;
    pointer-events: auto;
  }
  .hero-credit a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Phones / portrait: DJ sits centre-top, copy below on a bottom scrim */
  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .hero-section {
      align-items: flex-end;
    }
    .hero-scrim {
      background: linear-gradient(0deg, var(--sp-bg) 0%, rgba(5, 6, 5, 0.9) 40%, rgba(5, 6, 5, 0) 56%);
    }
    .hero-section #hero-content {
      padding-top: 38vh !important;
    }
    .hero-stats {
      margin-top: 36px;
    }
    .hero-credit {
      max-width: 60%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grain,
    .intro-card-grain,
    .eq-bar,
    .hero-scroll-cue span {
      animation: none;
    }
    .hero-canvas {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { onMainScroll } from '../lib/smooth-scroll';

  const root = document.documentElement;
  const section = document.getElementById('home') as HTMLElement;
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const card = document.getElementById('intro-card');
  const cardBar = document.getElementById('intro-card-bar');
  const cardStatus = document.getElementById('intro-card-status');
  const skipBtn = document.getElementById('hero-skip');
  const content = document.getElementById('hero-content');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Fixed overlays must live outside #main-scroll-content (Lenis transforms it, which traps position:fixed)
  if (card) document.body.appendChild(card);
  if (skipBtn) document.body.appendChild(skipBtn);

  const playing = root.classList.contains('intro-playing');
  const short = root.classList.contains('intro-short');

  // Very constrained connections get the CSS poster instead of a 11MB stage
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const skip3d = !!conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '');

  type Stage = Awaited<ReturnType<typeof import('../lib/hero-stage').createHeroStage>>;
  let stage: Stage | null = null;
  let modelReady = false;

  const stagePromise: Promise<Stage | null> = skip3d
    ? Promise.resolve(null)
    : import('../lib/hero-stage').then(({ createHeroStage }) => {
        stage = createHeroStage(canvas, {
          reducedMotion,
          onProgress: (p) => {
            if (cardBar) cardBar.style.transform = `scaleX(${p})`;
            if (cardStatus) cardStatus.textContent = `Setting up the decks… ${Math.round(p * 100)}%`;
          },
        });
        stage.ready
          .then(() => {
            modelReady = true;
            section.classList.add('is-stage-ready');
          })
          .catch(() => section.classList.add('is-stage-failed'));
        return stage;
      });

  /** Waits for the model, but never longer than `ms` */
  const modelOrTimeout = (ms: number) =>
    stagePromise.then((s) => (s ? Promise.race([s.ready.catch(() => {}), new Promise((r) => setTimeout(r, ms))]) : undefined));

  // ── Reveal of copy + app chrome ──
  let revealed = false;
  function revealUI(fast = false) {
    if (revealed) return;
    revealed = true;
    try {
      sessionStorage.setItem('intro-seen', '1');
    } catch {
      /* ignore */
    }
    root.classList.add('intro-reveal');
    const d = fast ? 0.35 : 1;
    const items = section.querySelectorAll('[data-intro]');
    const late = section.querySelectorAll('[data-intro-late]');
    gsap.set([...items, ...late], { opacity: 0 });
    // Name lines animate via CSS transition when intro-playing is removed (see styles)
    root.classList.remove('intro-playing');

    const tl = gsap.timeline({ onComplete: () => window.setTimeout(() => root.classList.remove('intro-reveal'), 1600) });
    tl.to('.hero-letterbox', { scaleY: 0, duration: 0.9 * d, ease: 'power3.inOut' }, 0)
      .fromTo(items, { y: 24, opacity: 0, filter: 'blur(8px)' }, { y: 0, opacity: 1, filter: 'blur(0px)', duration: 0.8 * d, ease: 'power3.out', stagger: 0.08 * d, clearProps: 'filter' }, 0.3 * d)
      .to(late, { opacity: 1, duration: 0.8 * d }, 0.9 * d);
    if (stage) gsap.to(stage.rig, { reveal: 1, duration: 1.4 * d, ease: 'power2.out' });
  }

  // ── Intro sequence ──
  let introTl: gsap.core.Timeline | null = null;

  function skipIntro() {
    if (revealed) return;
    introTl?.kill();
    if (card) gsap.to(card, { autoAlpha: 0, duration: 0.3 });
    if (stage) gsap.to(stage.rig, { pan: 1, duration: modelReady ? 0.8 : 0, ease: 'power2.inOut' });
    revealUI(true);
  }

  async function playIntro() {
    const s = await stagePromise;

    if (!playing || reducedMotion) {
      // No cinematic: final framing, everything visible
      if (s) {
        s.rig.pan = 1;
        s.rig.reveal = 1;
      }
      revealed = true;
      return;
    }

    if (!short && card) {
      // Title card holds until the model lands (max ~5s), then cuts to the stage
      await Promise.all([new Promise((r) => setTimeout(r, 1800)), modelOrTimeout(5000)]);
      if (revealed) return;
    } else {
      await modelOrTimeout(2500);
      if (revealed) return;
    }

    if (!s || !modelReady) {
      // Model still streaming: show the site now; the stage fades in when ready
      if (card) gsap.to(card, { autoAlpha: 0, duration: 0.6 });
      if (s) s.rig.pan = 1;
      revealUI();
      return;
    }

    const panDuration = short ? 2.6 : 6.8;
    introTl = gsap.timeline();
    if (card) introTl.to(card, { autoAlpha: 0, duration: 0.9, ease: 'power2.inOut' }, 0);
    introTl
      .fromTo(s.rig, { pan: short ? 0.55 : 0 }, { pan: 1, duration: panDuration, ease: 'power2.inOut' }, 0)
      .to(s.rig, { reveal: 0.35, duration: 1.2 }, 0)
      .add(() => revealUI(), panDuration - (short ? 0.6 : 1.4));
  }

  playIntro();

  // Any deliberate input during the intro skips it
  skipBtn?.addEventListener('click', skipIntro);
  if (playing && !reducedMotion) {
    const onInput = (e: Event) => {
      if (e instanceof KeyboardEvent && ['Shift', 'Control', 'Alt', 'Meta'].includes(e.key)) return;
      skipIntro();
      ['wheel', 'touchstart', 'keydown'].forEach((t) => window.removeEventListener(t, onInput));
    };
    ['wheel', 'touchstart', 'keydown'].forEach((t) => window.addEventListener(t, onInput, { passive: true }));
  }

  // ── Scroll: camera pushes in, copy drifts up and fades ──
  let scrollRaf = 0;
  onMainScroll(() => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      scrollRaf = 0;
      const rect = section.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height)));
      if (stage) stage.rig.scroll = p;
      if (content && revealed) {
        content.style.transform = `translate3d(0, ${p * -60}px, 0)`;
        content.style.opacity = String(1 - p * 1.3);
      }
    });
  });

  document.addEventListener('astro:before-swap', () => (stage as Stage | null)?.dispose());
</script>
