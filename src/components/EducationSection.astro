---
// EducationSection.astro — Styled as Spotify Lyrics & Credits screen
---

<section id="education" style="padding:60px 32px;background:linear-gradient(180deg,rgba(18,18,18,0.5) 0%,rgba(18,18,18,0.95) 100%);">
  
  <div class="reveal" style="margin-bottom:32px;">
    <p style="font-size:0.72rem;font-weight:700;color:var(--sp-green);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Sing Along</p>
    <h2 style="font-size:2rem;font-weight:800;color:#fff;letter-spacing:-0.02em;margin-bottom:4px;">Lyrics &amp; Credits</h2>
    <p style="font-size:0.875rem;color:var(--sp-text);">Academic milestones presented as synchronized lyrics</p>
  </div>

  <div style="display:grid;grid-template-columns:1.2fr 0.8fr;gap:24px;" class="edu-layout reveal">
    
    <!-- Left: Lyrics Screen (colored card matching Spotify Lyrics screen) -->
    <div style="background:#a63d1e;border-radius:12px;padding:40px;position:relative;overflow:hidden;min-height:480px;display:flex;flex-direction:column;justify-content:center;box-shadow:0 16px 40px rgba(166,61,30,0.15);" class="lyrics-card">
      <!-- Ambient light effect -->
      <div style="position:absolute;inset:0;background:radial-gradient(circle at 10% 20%,rgba(255,255,255,0.06),transparent 80%);pointer-events:none;"></div>
      
      <!-- Tiny top indicators -->
      <div style="position:absolute;top:24px;left:40px;display:flex;align-items:center;gap:12px;opacity:0.85;">
        <svg viewBox="0 0 24 24" fill="white" width="18" height="18"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        <span style="font-size:0.7rem;font-weight:800;color:#fff;text-transform:uppercase;letter-spacing:0.08em;">Academic Lyrics</span>
      </div>

      <!-- Large lyrics lines -->
      <div style="display:flex;flex-direction:column;gap:18px;margin-top:20px;" class="lyrics-lines">
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:rgba(0,0,0,0.45);margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Started coding back in twenty-twenty-one,
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:#fff;margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Graduated Magna Cum Laude with my BSIT degree,
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:#fff;margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Earned the Outstanding IT Graduate award with pride,
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:rgba(0,0,0,0.45);margin:0;line-height:1.25;letter-spacing:-0.02em;">
          And the IT Excellence recognition too.
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:#fff;margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Represented PSITS as Finance Volunteer &amp; Treasurer,
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:rgba(0,0,0,0.45);margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Shipped clean interfaces at Alliance Jumpstart Program,
        </p>
        <p style="font-size:clamp(1.2rem,3vw,1.7rem);font-weight:800;color:#fff;margin:0;line-height:1.25;letter-spacing:-0.02em;">
          Now we build scalable systems in the cloud.
        </p>
      </div>

      <!-- Sharing footer -->
      <div style="position:absolute;bottom:24px;right:40px;opacity:0.85;">
        <button style="background:rgba(255,255,255,0.15);border:none;border-radius:500px;padding:8px 16px;color:#fff;font-size:0.72rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;transition:background 0.15s;"
          onmouseover="this.style.background='rgba(255,255,255,0.25)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
          <svg viewBox="0 0 24 24" fill="white" width="12" height="12"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
          Share Lyrics
        </button>
      </div>
    </div>

    <!-- Right: Credits overlay (dark styled block) -->
    <div style="background:var(--sp-surface);border-radius:12px;padding:32px;border:1px solid var(--sp-border);display:flex;flex-direction:column;gap:24px;" class="credits-card">
      <div>
        <h3 style="font-size:1rem;font-weight:800;color:#fff;margin-bottom:16px;letter-spacing:-0.01em;">Album Credits</h3>
        <p style="font-size:0.75rem;color:var(--sp-text-dim);line-height:1.4;">Credits for the academic records and organizational roles supporting Dean's development.</p>
      </div>

      <div style="display:flex;flex-direction:column;gap:18px;">
        {[
          { label: 'Performers', name: 'Dean Lourence P. Barquio', role: 'Main Developer, QA Engineer, Academic Lead' },
          { label: 'Writers / Credentials', name: 'Magna Cum Laude', role: 'BS Information Technology Graduate (2021 – 2025)' },
          { label: 'Producers / Institutions', name: 'Cebu City University', role: 'Dean\'s Lister, IT Excellence, Outstanding IT Graduate' },
          { label: 'Publishers / Affiliations', name: 'PSITS & Alliance', role: 'Treasurer, Finance Volunteer (PSITS), Jumpstart Workshop' }
        ].map(item => (
          <div style="border-bottom:1px solid rgba(255,255,255,0.05);padding-bottom:14px;">
            <p style="font-size:0.68rem;font-weight:700;color:var(--sp-text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">{item.label}</p>
            <p style="font-size:0.86rem;font-weight:700;color:#fff;margin-bottom:2px;">{item.name}</p>
            <p style="font-size:0.72rem;color:var(--sp-text);line-height:1.4;">{item.role}</p>
          </div>
        ))}
      </div>

      <!-- Verified badge -->
      <div style="margin-top:auto;padding:12px 16px;background:rgba(29,185,84,0.06);border-radius:8px;border:1px solid rgba(29,185,84,0.12);display:flex;align-items:center;gap:10px;">
        <svg viewBox="0 0 24 24" fill="var(--sp-green)" width="18" height="18"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        <div>
          <p style="font-size:0.78rem;font-weight:700;color:#fff;line-height:1.2;">Academic Record Verified</p>
          <p style="font-size:0.65rem;color:var(--sp-text-dim);">Registrar &amp; Institution approved</p>
        </div>
      </div>

    </div>

  </div>

</section>

<style>
  @media (max-width: 900px) {
    .edu-layout {
      grid-template-columns: 1fr !important;
    }
    .lyrics-card {
      min-height: auto !important;
      padding: 32px 24px !important;
    }
  }
</style>
