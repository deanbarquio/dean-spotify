---
import World from '../layouts/World.astro';
import { PLACES } from '../lib/world/places';
import { projects, roles, milestones, skillGroups, education } from '../data/portfolio';
import { recommendations } from '../data/recommendations';

const num = (i: number) => String(i + 1).padStart(2, '0');
const links = [
  { href: 'https://github.com/deanbarquio', label: 'GitHub' },
  { href: 'https://linkedin.com/in/deanbarquio', label: 'LinkedIn' },
  { href: '/Cover Letter.pdf', label: 'Cover letter' },
];
const byId = new Map(projects.map((p) => [p.id, p]));
/** One row per place for the projects accordion; `gallery` feeds the fold's thumbnails */
const rows = PLACES.map((pl) => {
  const p = byId.get(pl.id);
  if (p) {
    const gallery = p.gallery ?? (p.image ? [p.image] : []);
    return { id: pl.id, title: p.title, year: p.year, kind: p.kind, image: p.image, paint: p.paint, summary: p.summary, stack: p.stack, url: p.url, study: true, gallery };
  }
  // The only non-project place is home (about)
  return {
    id: pl.id, title: 'Studio', year: '2021 — Now', kind: 'About Dean', image: '/profile.png', paint: pl.paint,
    summary: 'Interfaces where motion carries meaning: complex systems turned into products that feel calm, fast and alive.',
    stack: skillGroups.slice(0, 2).flatMap((g) => g.items.slice(0, 3)), url: undefined, study: false, gallery: [] as string[],
  };
});
const ENTER: Record<string, string> = { about: 'Visit the studio' };
const EMAIL = 'deanbarquio@gmail.com';
---

<World>
  <canvas id="world" class="world" aria-hidden="true"></canvas>

  <!-- Beacon labels, positioned over the 3D scene each frame -->
  <div class="markers">
    {PLACES.map((p, i) => (
      <button type="button" class="marker is-off" data-marker={p.id} style={`--paint:${p.paint}`} aria-label={`${p.label}, ${p.sub}`}>
        <span class="marker-ring" aria-hidden="true"></span>
        <span class="marker-label"><span class="marker-num">{num(i)}</span>{p.label}</span>
      </button>
    ))}
  </div>

  <!-- Guardian name tags: appear over the turtle and dragon while a beacon is open -->
  <div class="markers" aria-hidden="true">
    <span class="gtag is-off" data-guardian="turtle"><b>Aetherwing</b><i>Guardian · click</i></span>
    <span class="gtag is-off" data-guardian="dragon"><b>Prowler</b><i>Guardian · click</i></span>
  </div>

  <header class="hud hud--top">
    <button type="button" class="brand" id="nav-home" aria-label="Dean Barquio, back to overview">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M20 4a16 16 0 1 1-15.2 11" />
        <path d="M20 10a10 10 0 1 1-9.5 7" />
        <path d="M20 16a4 4 0 1 1-3.8 2.8" />
        <path d="M8 34 20 12l12 22" />
      </svg>
      <span class="brand-name">Dean Barquio</span>
      <span class="brand-sub">Frontend</span>
    </button>
    <nav class="nav" aria-label="Primary">
      <button type="button" class="nav-link" id="nav-projects" aria-controls="drawer">Projects</button>
      <button type="button" class="nav-link" data-open="about">Studio</button>
      <button type="button" class="nav-link" id="nav-contact" aria-controls="profile">Contact</button>
    </nav>
    <div class="hud-tools">
      <!-- Day / night: switchable any time, even while the light is still changing -->
      <button type="button" class="sky-btn" id="nav-sky" aria-pressed="false" aria-label="Daylight">
        <svg class="sky-sun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.6" />
          <path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" />
        </svg>
        <svg class="sky-moon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z" />
        </svg>
      </button>
      <button type="button" class="sound" id="nav-sound" aria-pressed="false" aria-label="Sound">
        <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="sr" id="sound-state">off</span>
      </button>
    </div>
  </header>

  <h1 class="headline">Building<br />interfaces<br />that move</h1>

  <!-- Referral reviews on the overview; steps aside whenever a place, the menu or a project is open -->
  <section class="reviews" id="reviews" aria-label="Referral reviews" aria-roledescription="carousel">
    <p class="reviews-head">
      <span>Referrals</span>
      <span class="reviews-count" id="reviews-count">01 / {String(recommendations.length).padStart(2, '0')}</span>
    </p>
    <div class="reviews-track" aria-live="polite">
      {recommendations.map((r, i) => (
        <figure class="review" data-review={i} hidden={i > 0} style={`--accent:${r.accent}`}>
          <blockquote>{r.quote[0]}</blockquote>
          <figcaption>
            <span class="review-avatar" aria-hidden="true">{r.initials}</span>
            <span class="review-who">
              <b>{r.name}</b>
              <i>{r.title.split(' · ')[0]} · {r.date}</i>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="reviews-nav">
      <button type="button" class="cap-btn" id="reviews-prev" aria-label="Previous review">←</button>
      <button type="button" class="cap-btn" id="reviews-next" aria-label="Next review">→</button>
    </div>
  </section>

  <footer class="hud hud--foot">
    <div class="foot-left">
      <button type="button" class="list-btn" id="nav-list" aria-expanded="false" aria-controls="drawer" aria-label="All projects">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h1M2 8h1M2 12h1M6 4h8M6 8h8M6 12h8" /></svg>
      </button>
      <!-- Who and how to reach: a pill in the foot bar that unfolds into a card. The full story stays in the Home beacon -->
      <div class="me">
        <button type="button" class="me-pill" id="me-pill" aria-expanded="false" aria-controls="profile">
          <img src="/profile.png" alt="" width="28" height="28" decoding="async" />
          <span class="me-name">Dean Barquio</span>
          <span class="me-status"><i class="profile-dot" aria-hidden="true"></i><span>Available</span></span>
        </button>
        <section class="profile" id="profile" aria-label="About Dean and contact" hidden>
          <div class="profile-id">
            <img class="profile-photo" src="/profile.png" alt="Portrait of Dean Barquio" width="48" height="48" decoding="async" />
            <p class="profile-who">
              <b>Dean Barquio</b>
              <span>{roles[0].role} · {roles[0].company}</span>
            </p>
          </div>
          <p class="profile-bio">Frontend engineer crafting interfaces where motion carries meaning. Open to roles and collabs with teams that care about craft.</p>
          <dl class="profile-facts">
            <div><dt>Based</dt><dd>Cebu, PH · GMT+8</dd></div>
            <div><dt>Status</dt><dd><i class="profile-dot" aria-hidden="true"></i>Available</dd></div>
          </dl>
          <a class="profile-mail" href={`mailto:${EMAIL}`} id="profile-mail">{EMAIL}</a>
          <div class="profile-links">
            {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}
            <button type="button" class="profile-more" data-open="about">About me <span aria-hidden="true">→</span></button>
          </div>
        </section>
      </div>
    </div>
    <p class="hint" aria-hidden="true">
      <span class="hint-desk">Drag to explore · Scroll to zoom · Click a light</span>
      <span class="hint-touch">Drag to explore · Pinch to zoom · Tap a light</span>
    </p>
  </footer>

  <!-- Night veil shared by the menu and project view: mist, vignette, lightning -->
  <div class="atmos" aria-hidden="true">
    <i class="fog"></i>
    <i class="fog fog--b"></i>
    <i class="bolt-flash" id="bolt-flash"></i>
  </div>

  <!-- Projects menu: an accordion; opening a row unfolds it in place with a way into its beacon -->
  <nav class="menu" id="drawer" aria-label="All projects" hidden>
    <ol class="menu-list">
      {rows.map((r, i) => (
        <li class="menu-item" style={`--paint:${r.paint}`}>
          <button
            type="button"
            class="menu-row"
            id={`row-${r.id}`}
            data-row={r.id}
            aria-expanded="false"
            aria-controls={`fold-${r.id}`}
          >
            <span class="menu-title"><span class="menu-num" aria-hidden="true">{num(i)}</span>{r.title}</span>
            <span class="menu-year">{r.year}</span>
            <span class="menu-kind">{r.kind}</span>
            <span class="menu-go"><span class="menu-plus" aria-hidden="true"></span><span class="menu-go-label">Details</span></span>
          </button>
          <div class="menu-fold" id={`fold-${r.id}`} role="region" aria-labelledby={`row-${r.id}`}>
            <div class="fold">
              <div class="fold-media">
                <figure class="fold-shot">
                  {r.image ? <img src={r.image} alt={`${r.title} preview`} loading="lazy" decoding="async" /> : <span class="fold-poster">{r.title}</span>}
                  <span class="fold-glare" aria-hidden="true"></span>
                  <span class="fold-num" aria-hidden="true">{num(i)}</span>
                </figure>
                {r.gallery.length > 1 && (
                  <div class="fold-thumbs" role="group" aria-label={`${r.title} screenshots`}>
                    {r.gallery.slice(0, 4).map((src, k) => (
                      <button type="button" class="fold-thumb" data-shot={src} aria-pressed={k === 0 ? 'true' : 'false'} aria-label={`Screenshot ${k + 1}`} style={`--k:${k}`}>
                        <img src={src} alt="" loading="lazy" decoding="async" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
              <div class="fold-copy">
                <dl class="fold-facts">
                  <div><dt>No.</dt><dd>{num(i)} / {num(rows.length - 1)}</dd></div>
                  <div><dt>Year</dt><dd>{r.year}</dd></div>
                  <div><dt>Type</dt><dd>{r.kind}</dd></div>
                </dl>
                <p class="fold-lead">{r.summary}</p>
                <ul class="fold-stack" aria-label="Stack">
                  {r.stack.slice(0, 6).map((s, k) => <li style={`--k:${k}`}>{s}</li>)}
                </ul>
                <div class="fold-actions">
                  <button type="button" class="action action--primary" data-place={r.id}>{ENTER[r.id] ?? 'Fly to beacon'} <span aria-hidden="true">→</span></button>
                  {r.study && <a class="action" href={`/work/${r.id}`}>Case study</a>}
                  {r.url && <a class="action" href={r.url} target="_blank" rel="noopener noreferrer">Live ↗</a>}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <button type="button" class="overview-btn" id="menu-close"><span aria-hidden="true">←</span> To overview</button>
  </nav>

  <section class="caption" id="caption" aria-live="polite" aria-label="Selected place" hidden>
    <p class="cap-sub" id="cap-sub"></p>
    <p class="cap-title" id="cap-title"></p>
    <button type="button" class="cap-view" id="cap-view">View project</button>
    <p class="cap-hint" aria-hidden="true">
      <span class="cap-mouse"><i></i></span>
      <span class="hint-desk">Scroll to enter</span>
      <span class="hint-touch">Swipe up to enter</span>
    </p>
    <div class="cap-nav">
      <button type="button" class="cap-btn" id="cap-close" aria-label="Back to the valley">✕</button>
      <button type="button" class="cap-btn" id="cap-prev" aria-label="Previous place">←</button>
      <button type="button" class="cap-btn" id="cap-next" aria-label="Next place">→</button>
    </div>
  </section>

  <div class="flash" aria-hidden="true"></div>

  <!-- Intro cinematic: letterbox bars and a single line over the phoenix -->
  <div class="letterbox" aria-hidden="true"><i></i><i></i></div>
  <div class="intro-cut" id="intro-cut" aria-hidden="true"></div>
  <p class="intro-line" aria-hidden="true">
    <span>Above the mist, a phoenix keeps watch</span>
    <small>Click to skip</small>
  </p>

  <!-- Project view: what you find on the other side of a portal -->
  <article class="panel" id="panel" aria-label="Project" hidden>
    <div class="panel-body" id="panel-body"></div>
    <button type="button" class="overview-btn" id="panel-close"><span aria-hidden="true">←</span> To overview</button>
    <div class="panel-step">
      <span class="panel-count" id="panel-count">01 / 12</span>
      <button type="button" class="cap-btn" id="panel-prev" aria-label="Previous project">←</button>
      <button type="button" class="cap-btn" id="panel-next" aria-label="Next project">→</button>
    </div>
  </article>

  <div class="gate" id="gate">
    <div class="gate-inner">
      <p class="eyebrow">Dean Barquio · Frontend &amp; creative engineer</p>
      <p class="gate-title">A valley of things<br />I've built</p>
      <div class="gate-load" aria-hidden="true">
        <span class="gate-track"><i id="gate-bar"></i></span>
        <span id="gate-pct">Shaping the valley…</span>
      </div>
    </div>
  </div>

  <!-- Project view content, one per place; cloned into the panel on open -->
  <div class="tpls" hidden>
    <section data-tpl="about">
      <figure class="pv-hero"><img src="/profile.png" alt="Portrait of Dean Barquio" loading="lazy" /></figure>
      <div class="pv-intro">
        <h2 tabindex="-1">Hi, I'm Dean.</h2>
        <div class="pv-main">
          <p class="pv-lead">I craft interfaces where motion carries meaning, turning complex systems into products that feel calm, fast and alive.</p>
          <dl class="pv-facts">
            <div><dt>Based</dt><dd>Cebu, PH</dd></div>
            <div><dt>Now</dt><dd>{roles[0].role}<br />{roles[0].company}</dd></div>
            <div><dt>Education</dt><dd>{education.degree}<br />{education.honors[0]}</dd></div>
            <div><dt>Toolbox</dt><dd>{skillGroups.slice(0, 3).map((g) => <span>{g.items.slice(0, 4).join(', ')}<br /></span>)}</dd></div>
          </dl>
          <p class="pv-text">Shipping production frontends at N-Compass TV by day; after hours I build cinematic web stories with Three.js and GSAP.</p>
          <h3>Journey</h3>
          <ol class="pv-rows">
            {milestones.map((m) => (
              <li>
                <span class="pv-meta">{m.tag}</span>
                <strong>{m.title}</strong>
                <span>{m.sub}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {projects.map((p) => {
      const shots = p.gallery ?? (p.image ? [p.image] : []);
      return (
        <section data-tpl={p.id}>
          {p.url ? (
            <figure class="pv-hero pv-live" style={`--paint:${p.paint}`}>
              <div class="pv-live-bar">
                <span class="pv-live-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="pv-live-url">{p.url.replace(/^https?:\/\/|\/$/g, '')}</span>
                <a class="pv-live-open" href={p.url} target="_blank" rel="noopener noreferrer">Open ↗</a>
              </div>
              <div class="pv-live-screen">
                {p.image ? <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" decoding="async" /> : <span class="pv-live-poster">{p.title}</span>}
                {/* src is set when the panel opens, so hidden templates never load the site */}
                <iframe data-src={p.url} title={`${p.title} live preview`} tabindex="-1"></iframe>
                <span class="pv-live-load" aria-hidden="true"><span>Loading live preview</span></span>
                <button type="button" class="pv-live-cover" aria-label={`Interact with the ${p.title} preview`}><span>Click to interact</span></button>
              </div>
            </figure>
          ) : p.image ? (
            <figure class="pv-hero"><img src={p.image} alt={`${p.title} screenshot`} loading="lazy" decoding="async" /></figure>
          ) : (
            <figure class="pv-hero pv-hero--poster" style={`--paint:${p.paint}`}><span>{p.title}</span></figure>
          )}
          <div class="pv-intro">
            <h2 tabindex="-1">{p.title}</h2>
            <div class="pv-main">
              <p class="pv-lead">{p.summary}</p>
              <dl class="pv-facts">
                <div><dt>Year</dt><dd>{p.year}</dd></div>
                <div><dt>Type</dt><dd>{p.kind}</dd></div>
              </dl>
              <p class="pv-text">{p.detail}</p>
              <h3>What it does</h3>
              <ul class="pv-features" style={`--paint:${p.paint}`}>
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <h3>Built with</h3>
              <ul class="pv-stack" style={`--paint:${p.paint}`}>
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
              <div class="pv-actions">
                <a class="action action--primary" href={`/work/${p.id}`}>Case study</a>
                {p.url && <a class="action" href={p.url} target="_blank" rel="noopener noreferrer">Live site ↗</a>}
              </div>
            </div>
          </div>
          {shots.length > 1 && (
            <div class="pv-gallery">
              {shots.slice(1).map((src, i) => (
                <figure class="pv-shot"><img src={src} alt={`${p.title} screenshot ${i + 2}`} loading="lazy" decoding="async" /></figure>
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>
</World>
