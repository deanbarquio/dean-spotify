---
import World from '../layouts/World.astro';
import { PLACES, ELEMENT_NAME, ELEMENTS } from '../lib/world/places';
import { RINGS, WALLS } from '../lib/world/terrain';
import { projects, roles, milestones, milestoneHref, skillGroups, education } from '../data/portfolio';
import { recommendations } from '../data/recommendations';

const num = (i: number) => String(i + 1).padStart(2, '0');
const links = [
  { href: 'https://github.com/deanbarquio', label: 'GitHub' },
  { href: 'https://linkedin.com/in/deanbarquio', label: 'LinkedIn' },
  { href: '/Cover Letter.pdf', label: 'Cover letter' },
];
const byId = new Map(projects.map((p) => [p.id, p]));
/** One row per place for the projects accordion; `gallery` feeds the fold's thumbnails */
const rows = PLACES.map((pl) => {
  const p = byId.get(pl.id);
  if (p) {
    const gallery = p.gallery ?? (p.image ? [p.image] : []);
    return { id: pl.id, title: p.title, year: p.year, kind: p.kind, image: p.image, paint: p.paint, summary: p.summary, stack: p.stack, url: p.url, study: true, gallery, featured: !!p.featured };
  }
  // The only non-project place is home (about)
  return {
    id: pl.id, title: 'Studio', year: '2021 — Now', kind: 'About Dean', image: '/me/portrait.webp', paint: pl.paint,
    summary: 'Interfaces where motion carries meaning: complex systems turned into products that feel calm, fast and alive.',
    stack: skillGroups.slice(0, 2).flatMap((g) => g.items.slice(0, 3)), url: undefined, study: false, gallery: [] as string[], featured: false,
  };
});
const ENTER: Record<string, string> = { about: 'Visit the studio' };
const EMAIL = 'deanbarquio@gmail.com';
const projectCount = PLACES.filter((p) => p.id !== 'about').length;
const since = Math.floor(milestones[0].at);
/** Index keeps each place's beacon number, whatever group it lands in */
const indexed = PLACES.map((p, i) => ({ p, i }));
/** Tour: featured first, then newest to oldest; Home closes the reel */
const tourStops = [
  ...PLACES.filter((p) => p.id !== 'about').sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || (byId.get(b.id)?.at ?? 0) - (byId.get(a.id)?.at ?? 0)),
  PLACES.find((p) => p.id === 'about')!,
].map((p) => {
  const pr = byId.get(p.id);
  const meta = ELEMENTS.find((e) => e.id === p.element);
  return {
    id: p.id,
    n: num(PLACES.indexOf(p)),
    title: pr?.title ?? 'Studio',
    kind: pr?.kind ?? 'About Dean',
    year: pr?.year ?? '2021 — Now',
    summary: pr?.summary ?? 'Interfaces where motion carries meaning: complex systems turned into products that feel calm, fast and alive.',
    stack: (pr?.stack ?? skillGroups.slice(0, 2).flatMap((g) => g.items.slice(0, 3))).slice(0, 5),
    image: pr?.image ?? '/me/portrait.webp',
    // Live site loads in the tour's browser window; without one, its screens cross-fade there
    url: pr?.url ?? null,
    shots: pr ? (pr.gallery ?? (pr.image ? [pr.image] : [])) : ['/me/portrait.webp', '/me/grad-1.webp', '/me/grad-2.webp'],
    features: (pr?.features ?? [...roles.filter((r) => r.current).map((r) => `${r.role} · ${r.company}`), `${education.honors[0]} · ${education.degree}`]).slice(0, 3),
    highlights: pr?.highlights ?? [],
    glyph: meta?.glyph ?? 'M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4',
    element: p.element,
    elementName: ELEMENT_NAME[p.element],
    color: meta?.color ?? p.paint,
    paint: p.paint,
    featured: !!p.featured,
  };
});
// Inline JSON: escape `<` so nothing in the data can close the script tag
const tourJson = JSON.stringify(tourStops).replace(/</g, '\\u003c');
const elementCount =Object.fromEntries(ELEMENTS.map((e) => [e.id, PLACES.filter((p) => p.element === e.id).length])) as Record<string, number>;
---

<World>
  <canvas id="world" class="world" aria-hidden="true"></canvas>

  <!-- Beacon labels, positioned over the 3D scene each frame -->
  <div class="markers">
    {PLACES.map((p, i) => (
      <button type="button" class="marker is-off" data-marker={p.id} style={`--paint:${p.paint}`} aria-label={`${p.label}, ${p.sub}`}>
        <span class="marker-ring" aria-hidden="true"></span>
        <span class="marker-label" aria-hidden="true">
          <span class="marker-num">{num(i)}</span>
          <span class="marker-name">{p.label}</span>
          <span class="marker-sub">{p.sub} · {ELEMENT_NAME[p.element]}</span>
        </span>
      </button>
    ))}
  </div>

  <!-- Guardian name tags: appear over the turtle and dragon while a beacon is open -->
  <div class="markers" aria-hidden="true">
    <span class="gtag is-off" data-guardian="turtle"><b>Aetherwing</b><i>Guardian · click</i></span>
    <span class="gtag is-off" data-guardian="dragon"><b>Prowler</b><i>Guardian · click</i></span>
  </div>

  <header class="hud hud--top">
    <button type="button" class="brand" id="nav-home" aria-label="Dean Barquio, back to overview">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M20 4a16 16 0 1 1-15.2 11" />
        <path d="M20 10a10 10 0 1 1-9.5 7" />
        <path d="M20 16a4 4 0 1 1-3.8 2.8" />
        <path d="M8 34 20 12l12 22" />
      </svg>
      <span class="brand-name">Dean Barquio</span>
      <span class="brand-sub">Frontend</span>
    </button>
    <nav class="nav" aria-label="Primary">
      <button type="button" class="nav-link" id="nav-projects" aria-controls="drawer">Projects</button>
      <button type="button" class="nav-link" data-open="about">Studio</button>
      <button type="button" class="nav-link" id="nav-contact" aria-controls="profile">Contact</button>
    </nav>
    <div class="hud-tools">
      <!-- Day / night: switchable any time, even while the light is still changing -->
      <button type="button" class="sky-btn" id="nav-sky" aria-pressed="false" aria-label="Daylight">
        <svg class="sky-sun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.6" />
          <path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" />
        </svg>
        <svg class="sky-moon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z" />
        </svg>
      </button>
      <button type="button" class="sound" id="nav-sound" aria-pressed="false" aria-label="Sound">
        <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="sr" id="sound-state">off</span>
      </button>
    </div>
  </header>

  <!-- Overview hero: who, what, where to start; the index lights its beacon in the valley on hover -->
  <section class="headline" aria-labelledby="headline-title">
    <p class="eyebrow hero-eyebrow">
      <span>Cebu, PH</span><i aria-hidden="true"></i><span>{projectCount} projects</span><i aria-hidden="true"></i><span>{since} — Now</span>
    </p>
    <h1 class="headline-title" id="headline-title">
      Building<br />interfaces<br />that <span class="hero-word-box"><span class="hero-word-sizer" aria-hidden="true">{ELEMENTS.map((e) => <span>{e.word}</span>)}</span><span class="hero-word" id="hero-word" data-el="air">move</span></span><span class="sr">, flow, endure and ignite</span>
    </h1>
    <p class="hero-sub">Frontend engineer turning complex systems into products that feel calm, fast and alive.</p>
    <!-- Element legend: each lights its beacons in the valley and lends the headline its word -->
    <div class="hero-elements" role="group" aria-label="Projects by element">
      {ELEMENTS.map((e) => (
        <button type="button" class="hero-el" data-element={e.id} style={`--el:${e.color}`} aria-label={`${ELEMENT_NAME[e.id]}: ${elementCount[e.id]} projects`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={e.glyph} /></svg>
          <span class="hero-el-name">{ELEMENT_NAME[e.id]}</span>
          <span class="hero-el-n" aria-hidden="true">{String(elementCount[e.id]).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
    <div class="hero-actions">
      <button type="button" class="action action--primary" id="hero-explore">Explore the valley <span aria-hidden="true">→</span></button>
      <button type="button" class="hero-link hero-tour" id="hero-tour"><span class="hero-tour-dot" aria-hidden="true"></span>Take the tour</button>
    </div>
    <nav class="hero-index" aria-label="Beacons in the valley">
      <p class="hero-index-head">
        <span aria-hidden="true">Featured</span>
        <span class="hero-lit" id="hero-lit" aria-live="polite">Beacons lit <b id="hero-lit-n">00</b> / {num(PLACES.length - 1)}</span>
      </p>
      <ul class="hero-featured">
        {indexed.filter(({ p }) => p.featured).map(({ p, i }) => {
          const img = byId.get(p.id)?.image;
          const meta = ELEMENTS.find((e) => e.id === p.element);
          return (
            <li>
              <button type="button" class="quest" data-beacon={p.id} data-el={p.element} style={`--paint:${p.paint};--el:${meta?.color ?? p.paint}`}>
                <span class="quest-num" aria-hidden="true">{num(i)}</span>
                <span class="quest-name">{p.label}</span>
                <span class="quest-kind">{p.sub}</span>
                {meta && <svg class="quest-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={meta.glyph} /></svg>}
                <!-- Preview surfaces beside the row on hover only -->
                <span class="quest-peek" aria-hidden="true">
                  {img ? <img src={img} alt="" loading="lazy" decoding="async" /> : <span class="quest-poster">{p.label}</span>}
                </span>
              </button>
            </li>
          );
        })}
      </ul>
      <button type="button" class="hero-link hero-all" id="hero-projects" aria-controls="drawer">All {projectCount} projects <span aria-hidden="true">↗</span></button>
      <p class="hero-index-head" aria-hidden="true">In the valley</p>
      <ul>
        {indexed.filter(({ p }) => !p.featured).map(({ p, i }) => (
          <li>
            <button type="button" data-beacon={p.id} style={`--paint:${p.paint}`}>
              <i aria-hidden="true"></i><span class="hero-index-num" aria-hidden="true">{num(i)}</span>{p.label}
            </button>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- Referral reviews on the overview; steps aside whenever a place, the menu or a project is open -->
  <section class="reviews" id="reviews" aria-label="Referral reviews" aria-roledescription="carousel">
    <p class="reviews-head">
      <span>Referrals</span>
      <span class="reviews-count" id="reviews-count">01 / {String(recommendations.length).padStart(2, '0')}</span>
    </p>
    <div class="reviews-track" aria-live="polite">
      {recommendations.map((r, i) => (
        <figure class="review" data-review={i} hidden={i > 0} style={`--accent:${r.accent}`}>
          <blockquote>{r.quote[0]}</blockquote>
          <figcaption>
            <span class="review-avatar" aria-hidden="true">{r.initials}</span>
            <span class="review-who">
              <b>{r.name}</b>
              <i>{r.title.split(' · ')[0]} · {r.date}</i>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="reviews-nav">
      <button type="button" class="cap-btn" id="reviews-prev" aria-label="Previous review">←</button>
      <button type="button" class="cap-btn" id="reviews-next" aria-label="Next review">→</button>
    </div>
  </section>

  <footer class="hud hud--foot">
    <div class="foot-left">
      <button type="button" class="list-btn" id="nav-list" aria-expanded="false" aria-controls="drawer" aria-label="All projects">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h1M2 8h1M2 12h1M6 4h8M6 8h8M6 12h8" /></svg>
      </button>
      <!-- Who and how to reach: a pill in the foot bar that unfolds into a card. The full story stays in the Home beacon -->
      <div class="me">
        <button type="button" class="me-pill" id="me-pill" aria-expanded="false" aria-controls="profile">
          <img src="/me/avatar.webp" alt="" width="28" height="28" decoding="async" />
          <span class="me-name">Dean Barquio</span>
          <span class="me-status"><i class="profile-dot" aria-hidden="true"></i><span>Available</span></span>
        </button>
        <section class="profile" id="profile" aria-label="About Dean and contact" hidden>
          <div class="profile-id">
            <img class="profile-photo" src="/me/avatar.webp" alt="Portrait of Dean Barquio" width="48" height="48" decoding="async" />
            <p class="profile-who">
              <b>Dean Barquio</b>
              <span>{roles[0].role} · {roles[0].company}</span>
            </p>
          </div>
          <p class="profile-bio">Frontend engineer crafting interfaces where motion carries meaning. Open to roles and collabs with teams that care about craft.</p>
          <dl class="profile-facts">
            <div><dt>Based</dt><dd>Cebu, PH · GMT+8</dd></div>
            <div><dt>Status</dt><dd><i class="profile-dot" aria-hidden="true"></i>Available</dd></div>
          </dl>
          <a class="profile-mail" href={`mailto:${EMAIL}`} id="profile-mail">{EMAIL}</a>
          <div class="profile-links">
            {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}
            <button type="button" class="profile-more" data-open="about">About me <span aria-hidden="true">→</span></button>
          </div>
        </section>
      </div>
    </div>
    <p class="hint" aria-hidden="true">
      <span class="hint-desk">Drag to explore · Scroll to zoom · Click a light</span>
      <span class="hint-touch">Drag to explore · Pinch to zoom · Tap a light</span>
    </p>
  </footer>

  <!-- Night veil shared by the menu and project view: mist, vignette, lightning -->
  <div class="atmos" aria-hidden="true">
    <i class="fog"></i>
    <i class="fog fog--b"></i>
    <i class="bolt-flash" id="bolt-flash"></i>
  </div>

  <!-- Projects menu: an accordion; opening a row unfolds it in place with a way into its beacon -->
  <nav class="menu" id="drawer" aria-label="All projects" hidden>
    <ol class="menu-list">
      {rows.map((r, i) => (
        <li class="menu-item" style={`--paint:${r.paint}`}>
          <button
            type="button"
            class="menu-row"
            id={`row-${r.id}`}
            data-row={r.id}
            aria-expanded="false"
            aria-controls={`fold-${r.id}`}
          >
            <span class="menu-title"><span class="menu-num" aria-hidden="true">{num(i)}</span>{r.title}{r.featured && <span class="menu-feat">Featured</span>}</span>
            <span class="menu-year">{r.year}</span>
            <span class="menu-kind">{r.kind}</span>
            <span class="menu-go"><span class="menu-plus" aria-hidden="true"></span><span class="menu-go-label">Details</span></span>
          </button>
          <div class="menu-fold" id={`fold-${r.id}`} role="region" aria-labelledby={`row-${r.id}`}>
            <div class="fold">
              <div class="fold-media">
                <figure class="fold-shot">
                  {r.image ? <img src={r.image} alt={`${r.title} preview`} loading="lazy" decoding="async" /> : <span class="fold-poster">{r.title}</span>}
                  <span class="fold-glare" aria-hidden="true"></span>
                  <span class="fold-num" aria-hidden="true">{num(i)}</span>
                </figure>
                {r.gallery.length > 1 && (
                  <div class="fold-thumbs" role="group" aria-label={`${r.title} screenshots`}>
                    {r.gallery.slice(0, 4).map((src, k) => (
                      <button type="button" class="fold-thumb" data-shot={src} aria-pressed={k === 0 ? 'true' : 'false'} aria-label={`Screenshot ${k + 1}`} style={`--k:${k}`}>
                        <img src={src} alt="" loading="lazy" decoding="async" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
              <div class="fold-copy">
                <dl class="fold-facts">
                  <div><dt>No.</dt><dd>{num(i)} / {num(rows.length - 1)}</dd></div>
                  <div><dt>Year</dt><dd>{r.year}</dd></div>
                  <div><dt>Type</dt><dd>{r.kind}</dd></div>
                </dl>
                <p class="fold-lead">{r.summary}</p>
                <ul class="fold-stack" aria-label="Stack">
                  {r.stack.slice(0, 6).map((s, k) => <li style={`--k:${k}`}>{s}</li>)}
                </ul>
                <div class="fold-actions">
                  <button type="button" class="action action--primary" data-place={r.id}>{ENTER[r.id] ?? 'Fly to beacon'} <span aria-hidden="true">→</span></button>
                  {r.study && <a class="action" href={`/work/${r.id}`}>Case study</a>}
                  {r.url && <a class="action" href={r.url} target="_blank" rel="noopener noreferrer">Live ↗</a>}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <button type="button" class="overview-btn" id="menu-close"><span aria-hidden="true">←</span> To overview</button>
  </nav>

  <section class="caption" id="caption" aria-live="polite" aria-label="Selected place" hidden>
    <p class="cap-sub" id="cap-sub"></p>
    <p class="cap-title" id="cap-title"></p>
    <button type="button" class="cap-view" id="cap-view">View project</button>
    <p class="cap-hint" aria-hidden="true">
      <span class="cap-mouse"><i></i></span>
      <span class="hint-desk">Scroll to enter</span>
      <span class="hint-touch">Swipe up to enter</span>
    </p>
    <div class="cap-nav">
      <button type="button" class="cap-btn" id="cap-close" aria-label="Back to the valley">✕</button>
      <button type="button" class="cap-btn" id="cap-prev" aria-label="Previous place">←</button>
      <button type="button" class="cap-btn" id="cap-next" aria-label="Next place">→</button>
    </div>
  </section>

  <div class="flash" aria-hidden="true"></div>

  <!-- Intro cinematic: letterbox bars and a single line over the phoenix -->
  <div class="letterbox" aria-hidden="true"><i></i><i></i></div>
  <div class="intro-cut" id="intro-cut" aria-hidden="true"></div>
  <p class="intro-line" aria-hidden="true">
    <span>Above the mist, a phoenix keeps watch</span>
    <small>Click to skip</small>
  </p>

  <!-- Project view: what you find on the other side of a portal -->
  <article class="panel" id="panel" aria-label="Project" hidden>
    <div class="panel-body" id="panel-body"></div>
    <button type="button" class="overview-btn" id="panel-close"><span aria-hidden="true">←</span> To overview</button>
    <div class="panel-step">
      <span class="panel-count" id="panel-count">01 / 12</span>
      <button type="button" class="cap-btn" id="panel-prev" aria-label="Previous project">←</button>
      <button type="button" class="cap-btn" id="panel-next" aria-label="Next project">→</button>
    </div>
  </article>

  <!-- Loading gate: a title card before reel one; its letterbox hands over to the phoenix intro -->
  <!-- Guided tour: letterboxed, the camera sways round each beacon while its film still and credits roll -->
  <section class="tour" id="tour" aria-label="Guided tour of projects" aria-roledescription="slideshow" hidden>
    <header class="tour-head">
      <span class="tour-reel">Tour · <b id="tour-n">01</b> / {num(tourStops.length - 1)}</span>
      <span class="tour-hint" aria-hidden="true">
        <span class="hint-desk">Scroll or ← → to move · Click to pause · Esc to exit</span>
        <span class="hint-touch">Swipe to move · Tap to pause</span>
      </span>
      <span class="tour-el" id="tour-el"></span>
    </header>
    <p class="tour-paused" aria-hidden="true"><span>❚❚</span> Paused</p>
    <!-- Chapter number, huge and hollow, behind the credits -->
    <span class="tour-ghost" id="tour-ghost" aria-hidden="true">01</span>

    <!-- The project itself: its live site in a browser window (or its screens, cross-fading) -->
    <figure class="tour-stage" id="tour-stage">
      <span class="tour-glow" aria-hidden="true"></span>
      <div class="tour-window">
        <div class="tour-bar">
          <span class="tour-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="tour-url" id="tour-url"></span>
          <span class="tour-live" id="tour-live"><i aria-hidden="true"></i><span id="tour-live-label">Live</span></span>
        </div>
        <div class="tour-screen" id="tour-screen">
          <img class="tour-shot" id="tour-img" alt="" decoding="async" />
          <img class="tour-shot tour-shot--b" id="tour-img-b" alt="" decoding="async" />
          <iframe id="tour-frame" title="Live project" tabindex="-1" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-forms"></iframe>
          <span class="tour-loading" id="tour-loading" aria-hidden="true"><i></i>Connecting to the live site</span>
          <button type="button" class="tour-interact" id="tour-interact">Try it live <span aria-hidden="true">↗</span></button>
          <button type="button" class="tour-back" id="tour-back">← Back to the tour</button>
        </div>
      </div>
      <figcaption class="tour-tc" id="tour-tc"></figcaption>
    </figure>

    <div class="tour-card" aria-live="polite">
      <p class="tour-kind">
        <svg class="tour-glyph" viewBox="0 0 24 24" aria-hidden="true"><path id="tour-glyph" d="" /></svg>
        <span id="tour-kind"></span>
      </p>
      <h2 class="tour-title"><span id="tour-title"></span></h2>
      <dl class="tour-meta">
        <div><dt>Year</dt><dd id="tour-year"></dd></div>
        <div><dt>Type</dt><dd id="tour-type"></dd></div>
        <div><dt>Element</dt><dd id="tour-elname"></dd></div>
      </dl>
      <p class="tour-sum" id="tour-sum"></p>
      <ol class="tour-feats" id="tour-feats" aria-label="Highlights"></ol>
      <ul class="tour-stack" id="tour-stack" aria-label="Stack"></ul>
    </div>

    <div class="tour-controls">
      <button type="button" class="tour-btn" id="tour-prev" aria-label="Previous project">←</button>
      <button type="button" class="tour-btn" id="tour-pause" aria-pressed="false">Pause</button>
      <button type="button" class="tour-btn" id="tour-next" aria-label="Next project">→</button>
      <p class="tour-upnext" id="tour-upnext"></p>
      <button type="button" class="tour-btn tour-btn--view" id="tour-view">Open project</button>
      <button type="button" class="tour-btn" id="tour-exit">End tour <span aria-hidden="true">✕</span></button>
    </div>
    <!-- Chapters: one segment per stop; the current one fills, any one can be jumped to -->
    <div class="tour-progress" id="tour-progress" role="group" aria-label="Tour chapters">
      {tourStops.map((s) => (
        <button type="button" class="tour-seg" aria-label={`Go to ${s.title}`}><i></i></button>
      ))}
    </div>
  </section>
  <script type="application/json" id="tour-data" set:html={tourJson}></script>

  <!-- Minimap: the spiral from above; dots fly to their beacon, the marker is where the camera looks -->
  <nav class="minimap" id="minimap" aria-label="Valley map">
    <svg viewBox="-90 -90 180 180" aria-hidden="true">
      <g id="map-rot">
        {RINGS.map((r) => {
          // Each ring drawn as arcs between its openings (half-gap = 7 / r radians, as in the terrain)
          const half = 7 / r.r;
          const gaps = r.gaps.map((g) => (g * Math.PI) / 180).sort((a, b) => a - b);
          return gaps.map((g, k) => {
            const a0 = g + half;
            const a1 = (k + 1 < gaps.length ? gaps[k + 1] : gaps[0] + Math.PI * 2) - half;
            const large = a1 - a0 > Math.PI ? 1 : 0;
            const p = (a: number) => `${(r.r * Math.cos(a)).toFixed(2)} ${(r.r * Math.sin(a)).toFixed(2)}`;
            return <path class="map-ring" d={`M${p(a0)} A${r.r} ${r.r} 0 ${large} 1 ${p(a1)}`} />;
          });
        })}
        {WALLS.map((wl) => {
          const a = (wl.a * Math.PI) / 180;
          return <path class="map-ring" d={`M${(wl.r0 * Math.cos(a)).toFixed(2)} ${(wl.r0 * Math.sin(a)).toFixed(2)} L${(wl.r1 * Math.cos(a)).toFixed(2)} ${(wl.r1 * Math.sin(a)).toFixed(2)}`} />;
        })}
        <g class="map-view" id="map-view"><path d="M0 0 L-9 -22 A24 24 0 0 1 9 -22 Z" /><circle r="2.6" /></g>
      </g>
    </svg>
    <div class="map-dots" id="map-dots">
      {PLACES.map((p, i) => (
        <button type="button" class="map-dot" data-beacon={p.id} data-x={p.x} data-z={p.z} data-el={p.element} style={`--paint:${p.paint}`} aria-label={`${num(i)} ${p.label}`}>
          <i aria-hidden="true"></i>
        </button>
      ))}
    </div>
  </nav>

  <div class="gate" id="gate">
    <i class="fog" aria-hidden="true"></i>
    <i class="fog fog--b" aria-hidden="true"></i>
    <div class="gate-bars" aria-hidden="true">
      <i><span>Reel 00 · Overworld</span><span>Cebu, PH · After dark</span></i>
      <i><span id="gate-pct">Shaping the valley…</span><span class="gate-num"><b id="gate-num">00</b> / 100</span></i>
    </div>
    <div class="gate-inner">
      <svg class="gate-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path pathLength="1" d="M20 4a16 16 0 1 1-15.2 11" />
        <path pathLength="1" d="M20 10a10 10 0 1 1-9.5 7" />
        <path pathLength="1" d="M20 16a4 4 0 1 1-3.8 2.8" />
        <path pathLength="1" d="M8 34 20 12l12 22" />
      </svg>
      <p class="eyebrow gate-eyebrow">Dean Barquio · Frontend &amp; creative engineer</p>
      <p class="gate-title">
        <span class="gate-line"><span>A valley of things</span></span>
        <span class="gate-line"><span>I've built</span></span>
      </p>
      <!-- The skyline draws itself as the island builds; the beacon on the peak lights when it's ready -->
      <svg class="gate-ridge" id="gate-ridge" viewBox="0 0 600 64" fill="none" aria-hidden="true">
        <path class="gate-ridge-base" d="M0 56 60 49l50 4 58-22 36 10 46-27 40 21 42-9 48 18 50-8 48 12 60-6 62 8" />
        <path class="gate-ridge-draw" id="gate-bar" pathLength="1" d="M0 56 60 49l50 4 58-22 36 10 46-27 40 21 42-9 48 18 50-8 48 12 60-6 62 8" />
        <circle class="gate-beacon" cx="250" cy="14" r="3" />
      </svg>
    </div>
  </div>

  <!-- Project view content, one per place; cloned into the panel on open -->
  <div class="tpls" hidden>
    <section data-tpl="about">
      <!-- Opening shot: the portrait framed as a film still, letterboxed with a title card -->
      <figure class="pv-hero pv-film">
        <img src="/me/portrait.webp" alt="Portrait of Dean Barquio at night, crouched by a graffiti wall" loading="lazy" decoding="async" />
        <span class="film-grain" aria-hidden="true"></span>
        <figcaption class="film-card" aria-hidden="true">
          <span class="film-tc">Reel 01 · Cebu, PH · After dark</span>
          <span class="film-name">Dean Barquio</span>
          <span class="film-sub">A frontend story</span>
        </figcaption>
      </figure>
      <div class="pv-intro">
        <h2 tabindex="-1">Hi, I'm Dean.</h2>
        <div class="pv-main">
          <p class="pv-lead">I craft interfaces where motion carries meaning, turning complex systems into products that feel calm, fast and alive.</p>
          <dl class="pv-facts">
            <div><dt>Based</dt><dd>Cebu, PH</dd></div>
            <div><dt>Now</dt><dd>{roles[0].role}<br />{roles[0].company}</dd></div>
            <div><dt>Education</dt><dd>{education.degree}<br />{education.honors[0]}</dd></div>
            <div><dt>Toolbox</dt><dd>{skillGroups.slice(0, 3).map((g) => <span>{g.items.slice(0, 4).join(', ')}<br /></span>)}</dd></div>
          </dl>
          <p class="pv-text">Shipping production frontends at N-Compass TV by day; after hours I build cinematic web stories with Three.js and GSAP.</p>
        </div>
      </div>

      <!-- Journey: tilted cards riding a ruler, the focused year ghosted large behind them -->
      <section class="pv-journey" aria-labelledby="journey-title">
        <div class="jr-pin">
        <header class="jr-head">
          <p class="reel-tc">Journey · {Math.floor(milestones[0].at)} — Now</p>
          <h3 class="jr-title" id="journey-title">The road so far</h3>
        </header>
        <div class="jr-stage">
          <p class="jr-ghost" aria-hidden="true"><span class="jr-ghost-year"></span><span class="jr-ghost-era"></span></p>
          <ol class="jr-track" tabindex="0" aria-label="Career timeline. Use the arrow keys to travel">
            {milestones.map((m, i) => (
              <li class:list={['jr-item', m.now && 'is-now']} style={m.paint && `--jr-hot:${m.paint}`} data-year={m.now ? 'Now' : Math.floor(m.at)} data-era={m.era}>
                <a class="jr-card" href={milestoneHref(m)} data-place={PLACES.some((pl) => pl.id === m.project) ? m.project : undefined} aria-current={i === 0 ? 'step' : undefined}>
                  <p class="jr-tag">{m.tag}</p>
                  <h4 class="jr-name">{m.title}</h4>
                  <div class="jr-media">
                    {m.image ? <img src={m.image} alt="" loading="lazy" decoding="async" draggable="false" /> : <span>{m.era}</span>}
                  </div>
                  <p class="jr-sub">{m.sub}</p>
                  <ul class="jr-stack" aria-label="Stack">
                    {m.stack.slice(0, 3).map((s) => <li>{s}</li>)}
                  </ul>
                </a>
                <span class="jr-year" aria-hidden="true">{m.now ? 'Now' : Math.floor(m.at)}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="jr-nav">
          <button type="button" class="cap-btn jr-prev" aria-label="Previous milestone">←</button>
          <div class="jr-dots">
            {milestones.map((m, i) => <button type="button" class="jr-dot" aria-label={`${m.tag}: ${m.title}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
          </div>
          <button type="button" class="cap-btn jr-next" aria-label="Next milestone">→</button>
        </div>
        <p class="jr-hint" aria-hidden="true">
          <span class="hint-desk">Scroll or ← → to travel · Click a card to open</span>
          <span class="hint-touch">Swipe up to travel · Tap a card to open</span>
        </p>
        </div>
      </section>

      <!-- Achievements: commencement told as two film stills, then the honors roll like end credits -->
      <section class="pv-reel" aria-labelledby="reel-title">
        <header class="reel-head">
          <p class="reel-tc">Reel 02 · Commencement · {education.period.split(' ').pop()}</p>
          <h3 class="reel-title" id="reel-title">Level cleared.</h3>
          <p class="reel-lead">{education.degree}, graduated {education.honors[0]}.</p>
        </header>
        <div class="reel-stills">
          <figure class="pv-still pv-still--a">
            <img src="/me/grad-1.webp" alt="Dean in graduation gown raising his diploma" loading="lazy" decoding="async" />
            <span class="film-grain" aria-hidden="true"></span>
            <figcaption><span class="still-tc">Sc. 01</span><span class="still-sub">Diploma in hand.</span></figcaption>
          </figure>
          <figure class="pv-still pv-still--b">
            <img src="/me/grad-2.webp" alt="Dean in graduation gown wearing his honors medal" loading="lazy" decoding="async" />
            <span class="film-grain" aria-hidden="true"></span>
            <figcaption><span class="still-tc">Sc. 02</span><span class="still-sub">Medal on, {education.honors[0]}.</span></figcaption>
          </figure>
        </div>
        <ol class="reel-credits" aria-label="Honors">
          {education.honors.map((h, i) => (
            <li style={`--k:${i}`}><span>{String(i + 1).padStart(2, '0')}</span>{h}</li>
          ))}
        </ol>
      </section>
    </section>

    {projects.map((p) => {
      const shots = p.gallery ?? (p.image ? [p.image] : []);
      return (
        <section data-tpl={p.id}>
          {p.url ? (
            <figure class="pv-hero pv-live" style={`--paint:${p.paint}`}>
              <div class="pv-live-bar">
                <span class="pv-live-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="pv-live-url">{p.url.replace(/^https?:\/\/|\/$/g, '')}</span>
                <a class="pv-live-open" href={p.url} target="_blank" rel="noopener noreferrer">Open ↗</a>
              </div>
              <div class="pv-live-screen">
                {p.image ? <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" decoding="async" /> : <span class="pv-live-poster">{p.title}</span>}
                {/* src is set when the panel opens, so hidden templates never load the site */}
                <iframe data-src={p.url} title={`${p.title} live preview`} tabindex="-1"></iframe>
                <span class="pv-live-load" aria-hidden="true"><span>Loading live preview</span></span>
                <button type="button" class="pv-live-cover" aria-label={`Interact with the ${p.title} preview`}><span>Click to interact</span></button>
              </div>
            </figure>
          ) : p.image ? (
            <figure class="pv-hero"><img src={p.image} alt={`${p.title} screenshot`} loading="lazy" decoding="async" /></figure>
          ) : (
            <figure class="pv-hero pv-hero--poster" style={`--paint:${p.paint}`}><span>{p.title}</span></figure>
          )}
          <div class="pv-intro">
            <h2 tabindex="-1">{p.title}</h2>
            <div class="pv-main">
              <p class="pv-lead">{p.summary}</p>
              <dl class="pv-facts">
                <div><dt>Year</dt><dd>{p.year}</dd></div>
                <div><dt>Type</dt><dd>{p.kind}</dd></div>
              </dl>
              <p class="pv-text">{p.detail}</p>
              <h3>What it does</h3>
              <ul class="pv-features" style={`--paint:${p.paint}`}>
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <h3>Built with</h3>
              <ul class="pv-stack" style={`--paint:${p.paint}`}>
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
              <div class="pv-actions">
                <a class="action action--primary" href={`/work/${p.id}`}>Case study</a>
                {p.url && <a class="action" href={p.url} target="_blank" rel="noopener noreferrer">Live site ↗</a>}
              </div>
            </div>
          </div>
          {shots.length > 1 && (
            <div class="pv-gallery">
              {shots.slice(1).map((src, i) => (
                <figure class="pv-shot"><img src={src} alt={`${p.title} screenshot ${i + 2}`} loading="lazy" decoding="async" /></figure>
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>
</World>
